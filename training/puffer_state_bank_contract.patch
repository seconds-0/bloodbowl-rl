+    m.attr("state_bank_bbs_bytes") = (unsigned long long)PUFFER_STATE_BANK_BBS_BYTES;
+    m.attr("state_bank_records") = (unsigned long long)PUFFER_STATE_BANK_RECORDS;
+    m.attr("state_bank_bbs_version") = PUFFER_STATE_BANK_BBS_VERSION;
