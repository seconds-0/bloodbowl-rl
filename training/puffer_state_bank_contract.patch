diff --git a/src/bindings.cu b/src/bindings.cu
index 60275848..0656ba18 100644
--- a/src/bindings.cu
+++ b/src/bindings.cu
@@ -13,6 +13,51 @@
 
 namespace py = pybind11;
 
+#ifdef PUFFER_HAS_STATE_BANK_STRATUM_QUERY
+extern "C" int my_state_bank_stratum_descriptor(
+    const char* family, uint32_t threshold, uint32_t* eligible_records,
+    char ordered_index_sha256[65]);
+
+static py::dict py_state_bank_stratum_descriptor(
+        py::handle family, py::handle threshold) {
+    if (!PyUnicode_Check(family.ptr())) {
+        throw py::type_error("family must be a string");
+    }
+    if (!PyLong_CheckExact(threshold.ptr())) {
+        throw py::type_error("threshold must be an exact integer");
+    }
+    unsigned long long raw_threshold =
+        PyLong_AsUnsignedLongLong(threshold.ptr());
+    if (PyErr_Occurred()) throw py::error_already_set();
+    if (raw_threshold > UINT32_MAX) {
+        throw py::value_error("threshold exceeds uint32");
+    }
+    Py_ssize_t family_size = 0;
+    const char* family_name =
+        PyUnicode_AsUTF8AndSize(family.ptr(), &family_size);
+    if (family_name == nullptr) throw py::error_already_set();
+    if ((size_t)family_size != strlen(family_name)) {
+        throw py::value_error("family must not contain NUL");
+    }
+    uint32_t eligible_records = 0;
+    char sha256[65] = {0};
+    int error = my_state_bank_stratum_descriptor(
+        family_name, (uint32_t)raw_threshold, &eligible_records, sha256);
+    if (error != 0) {
+        throw py::value_error(
+            "state-bank stratum descriptor query failed: " +
+            std::to_string(error));
+    }
+    py::dict result;
+    result["schema"] = PUFFER_STATE_BANK_STRATA_SCHEMA;
+    result["family"] = family_name;
+    result["threshold"] = (uint32_t)raw_threshold;
+    result["eligible_records"] = eligible_records;
+    result["sha256"] = sha256;
+    return result;
+}
+#endif
+
