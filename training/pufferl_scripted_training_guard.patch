 def validate_config(args):
     return validate_entropy_schedule_config(args)
 
+def guard_scripted_training(args):
+    env = args.get('env', {})
+    train = args.get('train', {})
+    scripted = bool(int(env.get('scripted_opponent', 0) or 0))
+    learning_active = float(train.get('learning_rate', 0.0) or 0.0) > 1e-9
+    if not scripted or not learning_active:
+        return
+
+    # LOCAL PATCH (bloodbowl-rl): the native/CUDA backend has the same
+    # scripted-row contamination risk as torch, but its selfplay/rollout path
+    # has no tested row-filter here. Block active native scripted training
+    # unless it is confined to a SCRIPTED BANK: env.scripted_bank_tag = b+1
+    # applies the bot only in the envs tagged for frozen bank b, whose bot
+    # seats occupy that bank's tail row slice -- rows the native prioritized
+    # sampler never selects (puffer_frozen_prio_mask). That is the same
+    # exclusion frozen-bank rows get, so the learner batch stays clean.
+    if not args.get('slowly'):
+        import math
+        def semantic_int(value, name, lower, upper):
+            try:
+                number = float(value or 0)
+            except (TypeError, ValueError) as exc:
+                raise RuntimeError(f'{name} must be an integer in {lower}..{upper}') from exc
+            if not math.isfinite(number) or not number.is_integer() or not lower <= number <= upper:
+                raise RuntimeError(f'{name} must be an integer in {lower}..{upper}')
+            return int(number)
+        bank_tag = semantic_int(env.get('scripted_bank_tag', 0),
+                                'env.scripted_bank_tag', 0, 8)
+        bank_mask = semantic_int(env.get('scripted_bank_mask', 0),
+                                 'env.scripted_bank_mask', 0, 255)
+        if bank_tag and bank_mask:
+            raise RuntimeError(
+                'env.scripted_bank_tag and env.scripted_bank_mask must be '
+                'mutually exclusive.')
+        if bank_tag <= 0 and bank_mask <= 0:
+            raise RuntimeError(
+                'scripted_opponent with learning_rate > 1e-9 is unsafe on the '
+                'native/CUDA backend: bot-side sampled actions are replaced by '
+                'c_step and the native PPO path does not implement scripted row '
+                'exclusion. Use --slowly for the torch row-filter, keep '
+                'learning_rate <= 1e-9 for frozen eval, or confine the bot to a '
+                'frozen bank with env.scripted_bank_tag or scripted_bank_mask.')
+        sp = args.get('selfplay', {})
+        vec = args.get('vec', {})
+        num_banks = semantic_int(vec.get('num_frozen_banks', 0),
+                                 'vec.num_frozen_banks', 0, 8)
+        valid_mask = (1 << num_banks) - 1 if num_banks > 0 else 0
+        selection_invalid = (bank_tag > num_banks or
+                             bank_mask & ~valid_mask)
+        if not int(sp.get('enabled', 0) or 0) or selection_invalid:
+            raise RuntimeError(
+                f'env scripted bank selector tag={bank_tag} mask={bank_mask} '
+                f'requires selfplay.enabled=1 and selected banks within '
+                f'1 <= tag <= vec.num_frozen_banks ({num_banks}); the bot '
+                'seat is only excluded from PPO inside a frozen-bank row slice.')
+        team = int(env.get('scripted_opponent_team', 1) or 0)
+        if team != 1:
+            raise RuntimeError(
+                'env scripted bank selection requires scripted_opponent_team=1: tagged '
+                'envs place the frozen bank (and so the bot) on slot 1 / AWAY.')
+
