+        / static_cast<double>(minibatch_size);
+    if (!std::isfinite(minibatches_real) ||
+            minibatches_real >
+                static_cast<double>(std::numeric_limits<int>::max())) {
+        throw std::runtime_error(
+            "minibatches per update exceed the supported integer range");
+    }
+    int minibatches_per_update =
+        static_cast<int>(std::floor(minibatches_real));
+    if (minibatches_per_update <= 0) {
+        throw std::runtime_error(
+            "training has zero minibatches per update");
+    }
+
+    double ent_coef = finite_binary32_config(
+        train_kwargs, "ent_coef", 0.0f,
+        std::numeric_limits<float>::max(),
+        "ent_coef must be finite, nonnegative, and representable as float32");
