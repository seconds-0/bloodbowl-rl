+inline void ppo_replay_cuda_check(cudaError_t status, const char* operation) {
+    if (status != cudaSuccess) {
+        throw std::runtime_error(
+            std::string("PPO entropy graph replay ") + operation +
+            " failed: " + cudaGetErrorString(status));
+    }
+}
+
+inline size_t ppo_replay_bounded_product(
+        size_t lhs, size_t rhs, const char* name) {
+    if (lhs == 0 || rhs == 0 ||
+            lhs > PPO_GRAPH_REPLAY_MAX_ELEMENTS / rhs) {
+        throw std::runtime_error(
+            std::string("PPO entropy graph replay invalid ") + name);
+    }
+    size_t count = lhs * rhs;
+    if (count > PPO_GRAPH_REPLAY_MAX_ELEMENTS) {
+        throw std::runtime_error(
+            std::string("PPO entropy graph replay oversized ") + name);
+    }
+    return count;
+}
+
+inline bool ppo_replay_near(
+        float actual, float expected, float absolute_tolerance,
+        float relative_tolerance) {
+    if (!std::isfinite(actual) || !std::isfinite(expected)) {
+        return false;
+    }
+    float scale = std::max(std::fabs(actual), std::fabs(expected));
+    return std::fabs(actual - expected) <=
+        absolute_tolerance + relative_tolerance * scale;
+}
+
+struct PPOGraphReplayResult {
+    float requested_coefficient;
+    float reduced_loss;
+    std::array<float, LOSS_N + 1> losses;
+    std::vector<float> logits_gradient;
+    std::vector<float> value_gradient;
+};
+
+// Capture the profile's exact PPO loss launch sequence once, then prove that
+// graph replay reads the current value through the graph-stable device pointer.
+// This is a regression guard, not part of the timed region below.
+void verify_ppoloss_entropy_graph_replay(PPOProfile* p) {
+    if (p == nullptr || p->N <= 0 || p->T <= 0 || p->A <= 1 ||
+            p->ka.is_continuous) {
+        throw std::runtime_error(
+            "PPO entropy graph replay requires a nonempty discrete profile");
+    }
+    if (p->ka.ent_coef == nullptr ||
+            p->ka.ent_coef != p->ent_coef_t.data) {
+        throw std::runtime_error(
+            "PPO entropy graph replay coefficient pointer is not stable");
+    }
+
+    size_t sequence_count = ppo_replay_bounded_product(
+        static_cast<size_t>(p->N), static_cast<size_t>(p->T),
+        "sequence size");
+    size_t gradient_count = ppo_replay_bounded_product(
+        sequence_count, static_cast<size_t>(p->A), "gradient size");
+    size_t logits_count = ppo_replay_bounded_product(
+        sequence_count, static_cast<size_t>(p->A + 1), "logits size");
+    std::vector<precision_t> logits(logits_count);
+
+    // create_ppoloss initializes through the legacy default stream. Complete
+    // that work before using a nonblocking stream for the capture fixture.
+    ppo_replay_cuda_check(
+        cudaDeviceSynchronize(), "initial device synchronization");
+    ppo_replay_cuda_check(
+        cudaMemcpy(
+            logits.data(), p->logits_t.data,
+            logits.size() * sizeof(precision_t), cudaMemcpyDeviceToHost),
+        "logits copy");
+
+    cudaStream_t stream = nullptr;
+    cudaGraph_t graph = nullptr;
+    cudaGraphExec_t graph_exec = nullptr;
+    ppo_replay_cuda_check(
+        cudaStreamCreateWithFlags(&stream, cudaStreamNonBlocking),
+        "stream creation");
+    ppo_replay_cuda_check(
+        cudaStreamBeginCapture(stream, cudaStreamCaptureModeThreadLocal),
+        "capture begin");
+    ppo_replay_cuda_check(
+        cudaMemsetAsync(p->loss.data, 0, sizeof(float), stream),
+        "captured loss reset");
+    ppo_replay_cuda_check(
+        cudaMemsetAsync(
+            p->losses_acc.data, 0,
+            (LOSS_N + 1) * sizeof(float), stream),
+        "captured telemetry reset");
+    ppo_loss_compute<<<p->ppo_grid, PPO_THREADS, 0, stream>>>(
+        p->ppo_partials.data, p->ka, p->ga);
+    ppo_replay_cuda_check(
+        cudaPeekAtLastError(), "captured PPO compute launch");
+    ppo_loss_reduce<<<1, LOSS_N + 1, 0, stream>>>(
+        p->loss.data, p->losses_acc.data,
+        p->ppo_partials.data, p->ppo_grid);
+    ppo_replay_cuda_check(
+        cudaPeekAtLastError(), "captured PPO reduction launch");
+    ppo_replay_cuda_check(
+        cudaStreamEndCapture(stream, &graph), "capture end");
+    if (graph == nullptr) {
+        throw std::runtime_error(
+            "PPO entropy graph replay capture returned a null graph");
+    }
+    ppo_replay_cuda_check(
+        cudaGraphInstantiate(&graph_exec, graph, 0),
+        "graph instantiation");
+    if (graph_exec == nullptr) {
+        throw std::runtime_error(
+            "PPO entropy graph replay instantiation returned a null graph");
+    }
+    ppo_replay_cuda_check(cudaGraphDestroy(graph), "graph destruction");
+    graph = nullptr;
+
+    constexpr std::array<float, 2> coefficients = {
+        0.03125f,
+        0.375f,
+    };
+    std::array<PPOGraphReplayResult, 2> results;
+    for (size_t replay = 0; replay < coefficients.size(); ++replay) {
+        PPOGraphReplayResult& result = results[replay];
+        result.requested_coefficient = coefficients[replay];
+        result.losses.fill(std::numeric_limits<float>::quiet_NaN());
+        result.logits_gradient.resize(gradient_count);
+        result.value_gradient.resize(sequence_count);
+
+        ppo_replay_cuda_check(
+            cudaMemcpyAsync(
+                p->ent_coef_t.data, &coefficients[replay], sizeof(float),
+                cudaMemcpyHostToDevice, stream),
+            "coefficient copy");
+        ppo_replay_cuda_check(
+            cudaGraphLaunch(graph_exec, stream), "graph launch");
+        ppo_replay_cuda_check(
+            cudaMemcpyAsync(
+                &result.reduced_loss, p->loss.data, sizeof(float),
+                cudaMemcpyDeviceToHost, stream),
+            "reduced loss copy");
+        ppo_replay_cuda_check(
+            cudaMemcpyAsync(
+                result.losses.data(), p->losses_acc.data,
+                result.losses.size() * sizeof(float),
+                cudaMemcpyDeviceToHost, stream),
+            "loss telemetry copy");
+        ppo_replay_cuda_check(
+            cudaMemcpyAsync(
+                result.logits_gradient.data(), p->grad_logits_t.data,
+                result.logits_gradient.size() * sizeof(float),
+                cudaMemcpyDeviceToHost, stream),
+            "logits gradient copy");
+        ppo_replay_cuda_check(
+            cudaMemcpyAsync(
+                result.value_gradient.data(), p->grad_values_t.data,
+                result.value_gradient.size() * sizeof(float),
+                cudaMemcpyDeviceToHost, stream),
+            "value gradient copy");
+        ppo_replay_cuda_check(
+            cudaStreamSynchronize(stream), "replay synchronization");
+        if (p->ka.ent_coef != p->ent_coef_t.data) {
+            throw std::runtime_error(
+                "PPO entropy graph replay coefficient address changed");
+        }
+    }
+
+    // Leave the microbenchmark in the same state create_ppoloss established.
+    float profile_coefficient = PPO_PROFILE_ENTROPY_COEFFICIENT;
+    ppo_replay_cuda_check(
+        cudaMemcpyAsync(
+            p->ent_coef_t.data, &profile_coefficient, sizeof(float),
+            cudaMemcpyHostToDevice, stream),
+        "profile coefficient restoration");
+    ppo_replay_cuda_check(
+        cudaMemsetAsync(
+            p->losses_acc.data, 0,
+            (LOSS_N + 1) * sizeof(float), stream),
+        "profile telemetry restoration");
+    ppo_replay_cuda_check(
+        cudaMemsetAsync(p->loss.data, 0, sizeof(float), stream),
+        "profile loss restoration");
+    ppo_replay_cuda_check(
+        cudaStreamSynchronize(stream), "restoration synchronization");
+    ppo_replay_cuda_check(
+        cudaGraphExecDestroy(graph_exec), "graph executable destruction");
+    graph_exec = nullptr;
+    ppo_replay_cuda_check(cudaStreamDestroy(stream), "stream destruction");
+    stream = nullptr;
+
+    for (const PPOGraphReplayResult& result : results) {
+        if (result.losses[LOSS_N] != 1.0f) {
+            throw std::runtime_error(
+                "PPO entropy graph replay did not execute exactly one loss");
+        }
+        if (result.losses[LOSS_ENT_COEF] !=
+                result.requested_coefficient) {
+            throw std::runtime_error(
+                "PPO entropy graph replay coefficient is not bit-exact");
+        }
+        float expected_entropy_term =
+            -result.requested_coefficient * result.losses[LOSS_ENT];
+        if (!ppo_replay_near(
+                result.losses[LOSS_ENT_TERM],
+                expected_entropy_term, 2e-6f, 2e-5f)) {
+            throw std::runtime_error(
+                "PPO entropy graph replay signed entropy term is invalid");
+        }
+        float expected_total =
+            result.losses[LOSS_PG] +
+            p->ka.vf_coef * result.losses[LOSS_VF] +
+            result.losses[LOSS_ENT_TERM];
+        if (!ppo_replay_near(
+                result.losses[LOSS_TOTAL],
+                expected_total, 3e-6f, 3e-5f) ||
+                !ppo_replay_near(
+                    result.reduced_loss, result.losses[LOSS_TOTAL],
+                    1e-6f, 1e-5f)) {
+            throw std::runtime_error(
+                "PPO entropy graph replay total loss decomposition is invalid");
+        }
+    }
+
+    const PPOGraphReplayResult& first = results[0];
+    const PPOGraphReplayResult& second = results[1];
+    for (int slot : {LOSS_PG, LOSS_VF, LOSS_ENT}) {
+        if (!std::isfinite(first.losses[slot]) ||
+                first.losses[slot] != second.losses[slot]) {
+            throw std::runtime_error(
+                "PPO entropy graph replay changed coefficient-independent losses");
+        }
+    }
+    if (first.losses[LOSS_ENT_COEF] == second.losses[LOSS_ENT_COEF] ||
+            first.losses[LOSS_ENT_TERM] == second.losses[LOSS_ENT_TERM] ||
+            first.losses[LOSS_TOTAL] == second.losses[LOSS_TOTAL]) {
+        throw std::runtime_error(
+            "PPO entropy graph replay did not change entropy-sensitive losses");
+    }
+    for (size_t idx = 0; idx < sequence_count; ++idx) {
+        if (!std::isfinite(first.value_gradient[idx]) ||
+                first.value_gradient[idx] != second.value_gradient[idx]) {
+            throw std::runtime_error(
+                "PPO entropy graph replay changed the value gradient");
+        }
+    }
+
+    float coefficient_delta =
+        second.requested_coefficient - first.requested_coefficient;
+    float max_expected_gradient_delta = 0.0f;
+    float max_observed_gradient_delta = 0.0f;
+    for (size_t row = 0; row < sequence_count; ++row) {
+        size_t logits_base = row * static_cast<size_t>(p->A + 1);
+        float max_logit = -std::numeric_limits<float>::infinity();
+        float exponential_sum = 0.0f;
+        for (int action = 0; action < p->A; ++action) {
+            float logit = to_float(logits[logits_base + action]);
+            if (logit > max_logit) {
+                exponential_sum *= std::exp(max_logit - logit);
+                max_logit = logit;
+            }
+            exponential_sum += std::exp(logit - max_logit);
+        }
+        float logsumexp = max_logit + std::log(exponential_sum);
+        float entropy = 0.0f;
+        for (int action = 0; action < p->A; ++action) {
+            float log_probability =
+                to_float(logits[logits_base + action]) - logsumexp;
+            float probability = std::exp(log_probability);
+            entropy -= probability * log_probability;
+        }
+        for (int action = 0; action < p->A; ++action) {
+            size_t gradient_index =
+                row * static_cast<size_t>(p->A) + action;
+            float log_probability =
+                to_float(logits[logits_base + action]) - logsumexp;
+            float probability = std::exp(log_probability);
+            float entropy_gradient =
+                probability * (-entropy - log_probability);
+            float expected_delta =
+                -coefficient_delta * entropy_gradient /
+                static_cast<float>(sequence_count);
+            float observed_delta =
+                second.logits_gradient[gradient_index] -
+                first.logits_gradient[gradient_index];
+            if (!ppo_replay_near(
+                    observed_delta, expected_delta, 5e-8f, 5e-3f)) {
+                throw std::runtime_error(
+                    "PPO entropy graph replay logits gradient ignored "
+                    "the replayed coefficient");
+            }
+            max_expected_gradient_delta = std::max(
+                max_expected_gradient_delta, std::fabs(expected_delta));
+            max_observed_gradient_delta = std::max(
+                max_observed_gradient_delta, std::fabs(observed_delta));
+        }
+    }
+    if (max_expected_gradient_delta <= 2e-7f ||
+            max_observed_gradient_delta <= 2e-7f) {
+        throw std::runtime_error(
+            "PPO entropy graph replay fixture lacks gradient sensitivity");
+    }
+}
