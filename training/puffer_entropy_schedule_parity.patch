+
+inline float entropy_coefficient_for_update(
+        double base, double min_ratio, bool anneal,
+        long update_index, long total_updates) {
+    if (!anneal) return static_cast<float>(base);
+    double progress =
+        static_cast<double>(update_index)
+        / static_cast<double>(total_updates);
+    progress = std::max(0.0, std::min(1.0, progress));
+    double floor_real = base * min_ratio;
+    constexpr double PI =
+        3.141592653589793238462643383279502884;
+    double coefficient_real =
+        floor_real
+        + 0.5 * (base - floor_real)
+            * (1.0 + std::cos(PI * progress));
+    return static_cast<float>(coefficient_real);
+}
+
+inline void validate_entropy_schedule_hypers(const HypersT& hypers) {
+    double base = hypers.ent_coef;
+    double min_ratio = hypers.min_ent_coef_ratio;
+    float applied_base = static_cast<float>(base);
+    float applied_ratio = static_cast<float>(min_ratio);
+    double floor_real = base * min_ratio;
+    float applied_floor = static_cast<float>(floor_real);
+    if (!std::isfinite(base) || base < 0.0
+            || !std::isfinite(applied_base)
+            || !std::isfinite(min_ratio)
+            || min_ratio < 0.0 || min_ratio > 1.0
+            || !std::isfinite(applied_ratio)
+            || !std::isfinite(floor_real)
+            || !std::isfinite(applied_floor)) {
+        throw std::runtime_error(
+            "invalid entropy schedule configuration");
+    }
+}
+
+inline void reset_entropy_schedule_state(PuffeRL& pufferl) {
+    validate_entropy_schedule_hypers(pufferl.hypers);
+    double base = pufferl.hypers.ent_coef;
+    float applied_base = static_cast<float>(base);
+    pufferl.current_ent_coef = applied_base;
+    pufferl.current_ent_epoch = -1;
+    pufferl.entropy_schedule_update_count = 0;
+    pufferl.entropy_loss_minibatch_count = 0;
+    pufferl.entropy_first_update = -1;
+    pufferl.entropy_last_update = -1;
+    pufferl.entropy_first_coefficient = 0.0f;
+    pufferl.entropy_last_coefficient = 0.0f;
+    pufferl.entropy_schedule_valid = false;
+    pufferl.training_failed = false;
+    pufferl.defer_entropy_schedule_commit = false;
+    pufferl.entropy_schedule_commit_pending = false;
+    pufferl.pending_entropy_update = -1;
+    pufferl.pending_entropy_minibatches = 0;
+    pufferl.pending_entropy_coefficient = 0.0f;
+}
+
+inline void commit_entropy_schedule_update(
+        PuffeRL& pufferl, long update_index,
+        int minibatches, float effective_coefficient) {
+    if (minibatches <= 0 ||
+            pufferl.entropy_loss_minibatch_count >
+                std::numeric_limits<long>::max() - minibatches) {
+        throw std::runtime_error(
+            "entropy telemetry minibatch count overflows");
+    }
+    if (pufferl.entropy_schedule_update_count == 0) {
+        pufferl.entropy_first_update = update_index;
+        pufferl.entropy_first_coefficient = effective_coefficient;
+    }
+    pufferl.current_ent_epoch = update_index;
+    pufferl.entropy_last_update = update_index;
+    pufferl.entropy_last_coefficient = effective_coefficient;
+    pufferl.entropy_schedule_update_count += 1;
+    pufferl.entropy_loss_minibatch_count += minibatches;
+    pufferl.entropy_schedule_valid = true;
 }
 
+inline void commit_pending_entropy_schedule_update(PuffeRL& pufferl) {
+    if (!pufferl.entropy_schedule_commit_pending) {
+        throw std::runtime_error(
+            "public training completed without pending entropy evidence");
+    }
+    commit_entropy_schedule_update(
+        pufferl,
+        pufferl.pending_entropy_update,
+        pufferl.pending_entropy_minibatches,
+        pufferl.pending_entropy_coefficient);
+    pufferl.epoch = pufferl.pending_entropy_update + 1;
+    pufferl.entropy_schedule_commit_pending = false;
+    pufferl.pending_entropy_update = -1;
+    pufferl.pending_entropy_minibatches = 0;
+    pufferl.pending_entropy_coefficient = 0.0f;
+}
