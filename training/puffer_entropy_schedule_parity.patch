+static py::handle require_config_value(py::dict& kwargs, const char* key) {
+    if (!kwargs.contains(key)) {
+        throw std::runtime_error(std::string("Missing config key: ") + key);
+    }
+    return kwargs[key];
+}
+
+static long long exact_config_integer(
+        py::dict& kwargs, const char* key, long long minimum,
+        long long maximum) {
+    py::handle value = require_config_value(kwargs, key);
+    if (!PyLong_CheckExact(value.ptr()) || PyBool_Check(value.ptr())) {
+        throw std::runtime_error(
+            std::string(key) + " must be an exact integer");
+    }
+    long long result = PyLong_AsLongLong(value.ptr());
+    if (PyErr_Occurred()) {
+        PyErr_Clear();
+        throw std::runtime_error(
+            std::string(key) + " is outside the supported integer range");
+    }
+    if (result < minimum || result > maximum) {
+        throw std::runtime_error(
+            std::string(key) + " is outside the supported integer range");
+    }
+    return result;
+}
+
+static double finite_binary32_config(
+        py::dict& kwargs, const char* key, float minimum, float maximum,
+        const char* error) {
+    py::handle value = require_config_value(kwargs, key);
+    if (PyBool_Check(value.ptr()) ||
+            (!PyLong_CheckExact(value.ptr()) &&
+             !PyFloat_CheckExact(value.ptr()))) {
+        throw std::runtime_error(error);
+    }
+    double real = PyFloat_AsDouble(value.ptr());
+    if (PyErr_Occurred()) {
+        PyErr_Clear();
+        throw std::runtime_error(error);
+    }
+    float narrowed = static_cast<float>(real);
+    if (!std::isfinite(real) || !std::isfinite(narrowed) ||
+            real < static_cast<double>(minimum) ||
+            real > static_cast<double>(maximum)) {
+        throw std::runtime_error(error);
+    }
+    return real;
+}
+
+static bool exact_bool01_config(py::dict& kwargs, const char* key) {
+    py::handle value = require_config_value(kwargs, key);
+    if (PyBool_Check(value.ptr())) {
+        return value.ptr() == Py_True;
+    }
+    if (!PyLong_CheckExact(value.ptr())) {
+        throw std::runtime_error(
+            "anneal_ent_coef must be an exact boolean or 0/1");
+    }
+    long long raw = PyLong_AsLongLong(value.ptr());
+    if (PyErr_Occurred()) {
+        PyErr_Clear();
+        throw std::runtime_error(
+            "anneal_ent_coef must be an exact boolean or 0/1");
+    }
+    if (raw != 0 && raw != 1) {
+        throw std::runtime_error(
+            "anneal_ent_coef must be an exact boolean or 0/1");
+    }
+    return raw == 1;
+}
