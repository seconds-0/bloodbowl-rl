+        .ent_coef = ent_coef,
+        .min_ent_coef_ratio = min_ent_coef_ratio,
+        .anneal_ent_coef = anneal_ent_coef,
+        .total_updates = total_updates,
+        .minibatches_per_update = minibatches_per_update,
+    };
