+        static_cast<long long>(std::numeric_limits<int>::max());
+    constexpr long long MAX_LONG =
+        static_cast<long long>(std::numeric_limits<long>::max());
+    long long total_agents = exact_config_integer(
+        vec_kwargs, "total_agents", 1, MAX_INT);
+    long long horizon = exact_config_integer(
+        train_kwargs, "horizon", 1, MAX_INT);
+    long long minibatch_size = exact_config_integer(
+        train_kwargs, "minibatch_size", 1, MAX_INT);
+    long long total_timesteps = exact_config_integer(
+        train_kwargs, "total_timesteps", 1, MAX_LONG);
