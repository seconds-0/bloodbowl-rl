+ENTROPY_SCHEDULE_CONTRACT = "cosine-update-index-over-total-updates-fp32-v1"
+
+
+def entropy_schedule_point(*, base_coefficient, anneal_enabled,
+        min_coefficient_ratio, update_index, total_updates):
+    '''Return one independently inspectable entropy schedule point.
+
+    Schedule arithmetic is binary64. The value used by the objective is
+    explicitly rounded to finite IEEE-754 binary32.
+    '''
+    base = pufferlib.pufferl._checked_config_real(
+        base_coefficient, 'base_coefficient')
+    if base < 0:
+        raise ValueError('base_coefficient must be nonnegative')
+    pufferlib.pufferl._finite_binary32(base, 'base_coefficient')
+
+    enabled = pufferlib.pufferl._checked_config_bool(
+        anneal_enabled, 'anneal_enabled')
+    min_ratio = pufferlib.pufferl._checked_config_real(
+        min_coefficient_ratio, 'min_coefficient_ratio')
+    if not 0 <= min_ratio <= 1:
+        raise ValueError('min_coefficient_ratio must be in [0, 1]')
+    pufferlib.pufferl._finite_binary32(
+        min_ratio, 'min_coefficient_ratio')
+
+    updates = pufferlib.pufferl._checked_config_integer(
+        total_updates, 'total_updates')
+    index = pufferlib.pufferl._checked_config_integer(
+        update_index, 'update_index',
+        minimum=-pufferlib.pufferl._MAX_SIGNED_LONG)
+    progress = min(max(float(index) / float(updates), 0.0), 1.0)
+    if enabled:
+        floor = base * min_ratio
+        c_real = floor + 0.5 * (base - floor) * (
+            1.0 + math.cos(math.pi * progress))
+    else:
+        c_real = base
+    c_applied = pufferlib.pufferl._finite_binary32(c_real, 'c_real')
+    return {
+        'contract': ENTROPY_SCHEDULE_CONTRACT,
+        'update_index': index,
+        'progress': progress,
+        "c_real": c_real,
+        "c_applied": c_applied,
+    }
+
