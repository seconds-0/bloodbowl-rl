+struct EntropyTrainingConfig {
+    int total_agents;
+    int horizon;
+    int minibatch_size;
+    float replay_ratio;
+    long total_timesteps;
+    double ent_coef;
+    double min_ent_coef_ratio;
+    bool anneal_ent_coef;
+    long total_updates;
+    int minibatches_per_update;
+};
+
+static EntropyTrainingConfig validate_entropy_training_config(
+        py::dict& train_kwargs, py::dict& vec_kwargs) {
+    constexpr long long MAX_INT =
+        static_cast<long long>(std::numeric_limits<int>::max());
+    constexpr long long MAX_LONG =
+        static_cast<long long>(std::numeric_limits<long>::max());
+    long long total_agents = exact_config_integer(
+        vec_kwargs, "total_agents", 1, MAX_INT);
+    long long horizon = exact_config_integer(
+        train_kwargs, "horizon", 1, MAX_INT);
+    long long minibatch_size = exact_config_integer(
+        train_kwargs, "minibatch_size", 1, MAX_INT);
+    long long total_timesteps = exact_config_integer(
+        train_kwargs, "total_timesteps", 1, MAX_LONG);
+    if (total_agents > MAX_INT / horizon) {
+        throw std::runtime_error(
+            "total_agents * horizon exceeds the supported batch range");
+    }
+    long long batch_size = total_agents * horizon;
+    if (minibatch_size > batch_size ||
+            minibatch_size % horizon != 0) {
+        throw std::runtime_error(
+            "minibatch_size must be horizon-divisible and no larger than "
+            "total_agents * horizon");
+    }
+    long total_updates =
+        static_cast<long>(total_timesteps / batch_size);
+    if (total_updates <= 0) {
+        throw std::runtime_error(
+            "training has zero complete updates");
     }
+
+    double replay_ratio_real = finite_binary32_config(
+        train_kwargs, "replay_ratio", 0.0f,
+        std::numeric_limits<float>::max(),
+        "replay_ratio must be finite, nonnegative, and representable as "
+        "float32");
+    float replay_ratio = static_cast<float>(replay_ratio_real);
+    double minibatches_real =
+        static_cast<double>(replay_ratio)
+        * static_cast<double>(batch_size)
+        / static_cast<double>(minibatch_size);
+    if (!std::isfinite(minibatches_real) ||
+            minibatches_real >
+                static_cast<double>(std::numeric_limits<int>::max())) {
+        throw std::runtime_error(
+            "minibatches per update exceed the supported integer range");
+    }
+    int minibatches_per_update =
+        static_cast<int>(std::floor(minibatches_real));
+    if (minibatches_per_update <= 0) {
+        throw std::runtime_error(
+            "training has zero minibatches per update");
+    }
+
+    double ent_coef = finite_binary32_config(
+        train_kwargs, "ent_coef", 0.0f,
+        std::numeric_limits<float>::max(),
+        "ent_coef must be finite, nonnegative, and representable as float32");
+    double min_ent_coef_ratio = finite_binary32_config(
+        train_kwargs, "min_ent_coef_ratio", 0.0f, 1.0f,
+        "min_ent_coef_ratio must be finite and in [0, 1]");
+    double floor_real = ent_coef * min_ent_coef_ratio;
+    float floor_applied = static_cast<float>(floor_real);
+    if (!std::isfinite(floor_real) || !std::isfinite(floor_applied)) {
+        throw std::runtime_error(
+            "entropy coefficient floor must be representable as float32");
+    }
+    bool anneal_ent_coef =
+        exact_bool01_config(train_kwargs, "anneal_ent_coef");
+
+    return EntropyTrainingConfig{
+        .total_agents = static_cast<int>(total_agents),
+        .horizon = static_cast<int>(horizon),
+        .minibatch_size = static_cast<int>(minibatch_size),
+        .replay_ratio = replay_ratio,
+        .total_timesteps = static_cast<long>(total_timesteps),
+        .ent_coef = ent_coef,
+        .min_ent_coef_ratio = min_ent_coef_ratio,
+        .anneal_ent_coef = anneal_ent_coef,
+        .total_updates = total_updates,
+        .minibatches_per_update = minibatches_per_update,
+    };
 }
 
