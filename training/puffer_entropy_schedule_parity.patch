+def _config_mapping(value, name):
+    if not isinstance(value, Mapping):
+        raise TypeError(f'{name} must be a mapping')
+    return value
+
+
+def _config_field(config, name, parent):
+    if name not in config:
+        raise ValueError(f'{parent} is missing required field {name!r}')
+    return config[name]
+
+
+def _checked_config_integer(
+        value, name, minimum=1, maximum=_MAX_SIGNED_LONG):
+    if type(value) is not int:
+        raise TypeError(f'{name} must be an integer')
+    result = value
+    if result < minimum or result > maximum:
+        raise ValueError(
+            f'{name} must be in [{minimum}, {maximum}], '
+            f'got {result}')
+    return result
+
+
+def _checked_config_real(value, name):
+    if type(value) not in (int, float):
+        raise TypeError(f'{name} must be a real number')
+    try:
+        result = float(value)
+    except OverflowError:
+        raise ValueError(f'{name} must be finite')
+    if not math.isfinite(result):
+        raise ValueError(f'{name} must be finite')
+    return result
+
+
+def _finite_binary32(value, name):
+    if abs(value) > _MAX_BINARY32:
+        raise ValueError(f'{name} must be representable as finite binary32')
+    try:
+        result = struct.unpack('!f', struct.pack('!f', value))[0]
+    except (OverflowError, struct.error):
+        raise ValueError(f'{name} must be representable as finite binary32')
+    if not math.isfinite(result):
+        raise ValueError(f'{name} must be representable as finite binary32')
+    return result
+
+
+def _checked_config_bool(value, name):
+    if type(value) is bool:
+        return value
+    if type(value) is int and value in (0, 1):
+        return bool(value)
+    raise TypeError(f'{name} must be a boolean or the integer 0 or 1')
