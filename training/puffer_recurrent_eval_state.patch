+    cudaMemcpyAsync(pufferl.evaluation_mode_puf, &device_enabled, sizeof(int),
+        cudaMemcpyHostToDevice, pufferl.default_stream);
+    cudaStreamSynchronize(pufferl.default_stream);
+    pufferl.evaluation_mode = enabled;
+}
