+def clone_recurrent_state(state):
+    return tuple(tensor.detach().clone() for tensor in state) if state else ()
+
+def require_empty_training_records(tail_valid, segment_state_valid):
+    if tail_valid or segment_state_valid:
+        raise RuntimeError(
+            'rollout would overwrite an unconsumed training segment')
+
+def require_complete_training_records(tail_valid, segment_state_valid):
+    if not tail_valid or not segment_state_valid:
+        raise RuntimeError(
+            'training requires one complete fresh segment and tail record')
 
+def gather_segment_initial_state(state, indices, total_agents):
+    result = []
+    for tensor in state:
+        if tensor.ndim != 3 or tensor.shape[1] != total_agents:
+            raise RuntimeError('stored recurrent state has wrong agent ownership')
+        result.append(tensor[:, indices].detach().clone())
+    return tuple(result)
