+def recurrent_forward_sequence(policy, observations, initial_state, terminals):
+    '''Recompute one TBPTT segment from its exact detached input state.
+
+    ``terminals[:, t]`` describes the transition immediately preceding
+    ``observations[:, t]``. This matches rollout storage, including t=0.
+    '''
+    if observations.ndim < 2 or terminals.shape != observations.shape[:2]:
+        raise RuntimeError('recurrent sequence observation/terminal shape mismatch')
+    state = clone_recurrent_state(initial_state)
+    logits_by_head = None
+    normal_loc, normal_scale = [], []
+    values = []
+    for t in range(observations.shape[1]):
+        state = reset_recurrent_state_rows(state, terminals[:, t])
+        logits, value, state = policy.forward_eval(observations[:, t], state)
+        if isinstance(logits, torch.distributions.Normal):
+            if logits_by_head is not None:
+                raise RuntimeError('recurrent policy changed action distribution type')
+            normal_loc.append(logits.loc)
+            normal_scale.append(logits.scale)
+        else:
+            if normal_loc:
+                raise RuntimeError('recurrent policy changed action distribution type')
+            heads = (logits,) if isinstance(logits, torch.Tensor) else tuple(logits)
+            if logits_by_head is None:
+                logits_by_head = [[] for _ in heads]
+            if len(heads) != len(logits_by_head):
+                raise RuntimeError('recurrent policy changed action-head count')
+            for output, head in zip(logits_by_head, heads):
+                output.append(head)
+        values.append(value.reshape(value.shape[0], -1)[:, 0])
+    if normal_loc:
+        loc = torch.stack(normal_loc, dim=1).reshape(-1, normal_loc[0].shape[-1])
+        scale = torch.stack(normal_scale, dim=1).reshape(
+            -1, normal_scale[0].shape[-1])
+        flat_logits = torch.distributions.Normal(loc, scale)
+    else:
+        flat_logits = [torch.stack(head, dim=1).reshape(
+            -1, head[0].shape[-1]) for head in logits_by_head]
+        if len(flat_logits) == 1:
+            flat_logits = flat_logits[0]
+    return flat_logits, torch.stack(values, dim=1), clone_recurrent_state(state)
+
+def evaluate_recurrent_tail(policy, observation, state, rewards, terminals):
+    '''Value the post-step observation without advancing behavior state.'''
+    behavior_before = clone_recurrent_state(state)
+    tail_state = reset_recurrent_state_rows(
+        clone_recurrent_state(state), terminals)
+    with torch.no_grad():
+        _, value, _ = policy.forward_eval(observation, tail_state)
+    value = value.flatten()
+    value = torch.where(terminals.bool(), torch.zeros_like(value), value)
+    return (value, rewards.detach().clone(), terminals.detach().clone(),
+            behavior_before)
 
