+    host["entropy_loss_minibatch_count"] =
+        pufferl.entropy_loss_minibatch_count;
+    host["entropy_first_update"] = pufferl.entropy_first_update;
+    host["entropy_last_update"] = pufferl.entropy_last_update;
+    host["entropy_first_coefficient"] =
+        pufferl.entropy_first_coefficient;
+    host["entropy_last_coefficient"] =
+        pufferl.entropy_last_coefficient;
+    host["entropy_schedule_valid"] = pufferl.entropy_schedule_valid;
+    host["defer_entropy_schedule_commit"] =
+        pufferl.defer_entropy_schedule_commit;
+    host["entropy_schedule_commit_pending"] =
+        pufferl.entropy_schedule_commit_pending;
