+
+    py::dict host;
+    host["epoch"] = pufferl.epoch;
+    host["global_step"] = pufferl.global_step;
+    host["training_failed"] = pufferl.training_failed;
+    host["current_ent_coef"] = pufferl.current_ent_coef;
+    host["current_ent_epoch"] = pufferl.current_ent_epoch;
+    host["entropy_schedule_update_count"] =
