diff --git a/src/scripted_bank_skip.h b/src/scripted_bank_skip.h
new file mode 100644
index 0000000..703e988
--- /dev/null
+++ b/src/scripted_bank_skip.h
@@ -0,0 +1,88 @@
+#pragma once
+// LOCAL PATCH (bloodbowl-rl, opt-in): training/puffer_skip_scripted_bank_forward.patch.
+// Host-only helpers, kept free of CUDA so the keying and routing rules compile
+// and run in tools/test_skip_scripted_bank_forward.py on a machine without nvcc.
+#include <stddef.h>
+#include <stdio.h>
+
+#define SCRIPTED_BANK_SKIP_AWAY_SEAT 1
+
+// Rollout-loop index of the frozen bank whose policy forward is discarded, or
+// 0 when no bank qualifies. Loop index b > 0 is frozen bank b-1, which
+// selfplay.py tags b, so the index equals env.scripted_bank_tag. This mirrors
+// bloodbowl.h c_step: a tagged env ignores the policy action on its AWAY seat
+// only when scripted_opponent != 0, scripted_opponent_team == AWAY and
+// env->tag == scripted_bank_tag. Every other configuration keeps the forward.
+static inline int scripted_bank_skip_index(
+        int is_bloodbowl, int scripted_opponent, int scripted_opponent_team,
+        int scripted_bank_tag, int num_frozen_banks) {
+    if (!is_bloodbowl || scripted_opponent == 0) return 0;
+    if (scripted_opponent_team != SCRIPTED_BANK_SKIP_AWAY_SEAT) return 0;
+    if (scripted_bank_tag < 1 || scripted_bank_tag > num_frozen_banks) return 0;
+    return scripted_bank_tag;
+}
+
+// 0 when every row of the skipped bank's per-buffer slice is the AWAY seat of
+// an env tagged skip_bank, and every such seat lands inside that slice.
+// Otherwise writes the first violation into err and returns 1. agent_perm maps
+// slot -> physical row; env e owns slots [e*agents_per_env, (e+1)*agents_per_env).
+static inline int scripted_bank_skip_validate(
+        int skip_bank, int num_buffers, int agents_per_buffer,
+        const int* bank_layout, int num_banks, int num_envs, int agents_per_env,
+        const int* env_tags, const int* agent_perm, char* err, size_t err_size) {
+    if (skip_bank < 1 || skip_bank >= num_banks) {
+        snprintf(err, err_size, "skip bank %d outside frozen banks 1..%d",
+                 skip_bank, num_banks - 1);
+        return 1;
+    }
+    if (bank_layout == NULL || agent_perm == NULL || env_tags == NULL) {
+        snprintf(err, err_size,
+                 "no selfplay routing (bank_layout, agent_perm or env tags missing)");
+        return 1;
+    }
+    if (agents_per_env != 2 || num_buffers <= 0 || agents_per_buffer <= 0 ||
+            (long)num_envs * agents_per_env != (long)num_buffers * agents_per_buffer) {
+        snprintf(err, err_size,
+                 "layout %d envs x %d agents does not tile %d buffers x %d agents",
+                 num_envs, agents_per_env, num_buffers, agents_per_buffer);
+        return 1;
+    }
+    int lo = bank_layout[skip_bank];
+    int hi = bank_layout[skip_bank + 1];
+    if (lo < 0 || hi > agents_per_buffer || hi <= lo) {
+        snprintf(err, err_size, "bank %d slice [%d,%d) is empty or out of range",
+                 skip_bank, lo, hi);
+        return 1;
+    }
+    long total = (long)num_buffers * agents_per_buffer;
+    long seats = 0;
+    for (int e = 0; e < num_envs; e++) {
+        for (int s = 0; s < agents_per_env; s++) {
+            int slot = e * agents_per_env + s;
+            int phys = agent_perm[slot];
+            if (phys < 0 || phys >= total) {
+                snprintf(err, err_size, "agent_perm[%d]=%d outside %ld rows",
+                         slot, phys, total);
+                return 1;
+            }
+            int col = phys % agents_per_buffer;
+            int in_slice = col >= lo && col < hi;
+            int bot_seat = env_tags[e] == skip_bank &&
+                s == SCRIPTED_BANK_SKIP_AWAY_SEAT;
+            if (in_slice != bot_seat) {
+                snprintf(err, err_size,
+                         "env %d seat %d (tag %d) routes to row %d, %s bank %d slice [%d,%d)",
+                         e, s, env_tags[e], phys, in_slice ? "inside" : "outside",
+                         skip_bank, lo, hi);
+                return 1;
+            }
+            seats += bot_seat;
+        }
+    }
+    if (seats != (long)num_buffers * (hi - lo)) {
+        snprintf(err, err_size, "%ld scripted seats for %ld bank %d rows",
+                 seats, (long)num_buffers * (hi - lo), skip_bank);
+        return 1;
+    }
+    return 0;
+}
