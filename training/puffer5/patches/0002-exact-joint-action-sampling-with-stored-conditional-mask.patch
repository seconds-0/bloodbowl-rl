# 0002: exact joint action sampling with stored conditional masks
diff --git a/src/exact_joint.h b/src/exact_joint.h
new file mode 100644
index 00000000..ee4dcabb
--- /dev/null
+++ b/src/exact_joint.h
@@ -0,0 +1,53 @@
+// Exact sequential joint action support (bloodbowl-rl exact-joint-v1 port).
+//
+// An env transports its current legal joint support as packed tuples: each
+// uint32 carries up to three 10-bit head values (head h at bits 10*h).
+// sample_logits samples head 0, then head 1 restricted to tuples whose head 0
+// equals the sampled value, then head 2 restricted to both. For each head the
+// conditional support is written into the rollout action-mask row, so the
+// stored mask is the complete behaviour-distribution artifact that PPO
+// recomputes against; no ragged history survives the rollout step.
+//
+// Host-testable: define __host__/__device__/precision_t/from_float/to_float
+// before including when compiling outside src/pufferl.cu.
+#pragma once
+#include <stdint.h>
+
+#define PUF_JOINT_HEAD_BITS 10
+#define PUF_JOINT_HEAD_MASK 1023u
+#define PUF_JOINT_MAX_HEADS 3
+
+__host__ __device__ static inline int puf_joint_head_value(uint32_t packed, int h) {
+    return (int)((packed >> (PUF_JOINT_HEAD_BITS * h)) & PUF_JOINT_HEAD_MASK);
+}
+
+// Writes the support of head h conditioned on the already-selected earlier
+// heads (selected[0..h-1], stored as floats like the rollout action buffer)
+// into mask_out[0..A-1] (1 = enabled). Returns the number of enabled values.
+__host__ __device__ static inline int puf_joint_fill_head_mask(
+        const uint32_t* support, int count, int h, const float* selected,
+        int A, precision_t* mask_out) {
+    for (int a = 0; a < A; ++a) {
+        mask_out[a] = from_float(0.0f);
+    }
+    int enabled = 0;
+    for (int j = 0; j < count; ++j) {
+        uint32_t packed = support[j];
+        int prefix = 1;
+        for (int p = 0; p < h; ++p) {
+            if (puf_joint_head_value(packed, p) != (int)selected[p]) {
+                prefix = 0;
+                break;
+            }
+        }
+        if (!prefix) {
+            continue;
+        }
+        int v = puf_joint_head_value(packed, h);
+        if (v < A && to_float(mask_out[v]) == 0.0f) {
+            mask_out[v] = from_float(1.0f);
+            enabled++;
+        }
+    }
+    return enabled;
+}
