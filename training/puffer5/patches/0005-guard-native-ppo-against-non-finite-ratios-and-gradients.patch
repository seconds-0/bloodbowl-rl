diff --git a/src/ppo_guard.h b/src/ppo_guard.h
new file mode 100644
index 00000000..99887d3e
--- /dev/null
+++ b/src/ppo_guard.h
@@ -0,0 +1,21 @@
+// Native PPO NaN guard (bloodbowl-rl port of 4.0 commit f14b71c).
+//
+// The importance ratio is exp(clamp(logratio, -10, 10)) while the KL metrics
+// keep the raw logratio; a PPO element with any non-finite input contributes
+// zero gradient and zero loss; and Muon skips the momentum and weight update
+// when the global gradient norm is non-finite.
+#pragma once
+
+__host__ __device__ static inline float puf_ppo_ratio_logratio(float raw_logratio) {
+    return fminf(10.0f, fmaxf(-10.0f, raw_logratio));
+}
+
+__host__ __device__ static inline bool puf_ppo_element_finite(float new_logp,
+        float old_logp, float advantage, float value_pred, float value, float ret) {
+    return isfinite(new_logp) && isfinite(old_logp) && isfinite(advantage)
+        && isfinite(value_pred) && isfinite(value) && isfinite(ret);
+}
+
+__host__ __device__ static inline bool puf_muon_norm_ok(float sum_sq) {
+    return isfinite(sum_sq) && sum_sq >= 0.0f;
+}
