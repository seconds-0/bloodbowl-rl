 // gradient.
 //
 // Minibatches stay contiguous row slices [mb*mb_segs, +mb_segs) of the
-// gathered buffer. When the eligible count is not a multiple of mb_segs the
-// map wraps into a pad region of mb_segs rows, so every slice is in bounds.
+// gathered buffer. Slices that run past the eligible count read a pad region
+// where the map wraps around to the first learner rows; the pad is sized to
+// the furthest reachable slice end, so every slice is in bounds.
 // The start row rotates by total_minibatches*mb_segs each epoch, so with
 // replay_ratio < 1 every learner row is still visited (upstream always
 // trained rows [0, rr*total) and never the rest).
 #pragma once
 
-static inline int puf_train_pad_rows(int eligible, int mb_segs) {
-    return (eligible % mb_segs) ? mb_segs : 0;
+// Rows past the eligible count that the minibatch slices
+// [(mb*mb_segs) % eligible, +mb_segs) actually reach, mb in [0, total_minibatches).
+static inline int puf_train_pad_rows(int eligible, int mb_segs, int total_minibatches) {
+    if (eligible <= 0) {
+        return 0;
+    }
+    long pad = 0;
+    for (long mb = 0; mb < total_minibatches; ++mb) {
+        long end = (mb * mb_segs) % eligible + mb_segs;
+        if (end - eligible > pad) {
+            pad = end - eligible;
+        }
+    }
+    return (int)pad;
 }
 
