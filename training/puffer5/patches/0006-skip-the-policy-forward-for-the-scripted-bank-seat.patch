diff --git a/src/scripted_bank.h b/src/scripted_bank.h
new file mode 100644
index 00000000..26d025f0
--- /dev/null
+++ b/src/scripted_bank.h
@@ -0,0 +1,23 @@
+// Scripted bank seat (bloodbowl-rl port of puffer_skip_scripted_bank_forward).
+//
+// The Blood Bowl env plays the AWAY seat of every env whose tag equals
+// env.scripted_bank_tag with a deterministic scripted bot and never reads the
+// policy action there (bloodbowl.h c_step). 5.0's env_setup tags an env with
+// the largest policy index among its seats, and the adapter routes seat 1 of
+// historical envs to frozen policy 1 + bank, so the bot seats are exactly the
+// rows of frozen policy `scripted_bank_tag`. That policy's forward and
+// sampling are discarded work; the trainer skips them. Those rows are frozen
+// rows and never reach PPO (train_rows.h).
+#pragma once
+
+// Policy index whose rollout forward is skipped, or 0 for none.
+static inline int puf_scripted_skip_policy(int scripted_opponent,
+        int scripted_opponent_team, int scripted_bank_tag, int num_policies) {
+    if (!scripted_opponent || scripted_opponent_team != 1) {
+        return 0;
+    }
+    if (scripted_bank_tag < 1 || scripted_bank_tag > num_policies - 1) {
+        return 0;
+    }
+    return scripted_bank_tag;
+}
