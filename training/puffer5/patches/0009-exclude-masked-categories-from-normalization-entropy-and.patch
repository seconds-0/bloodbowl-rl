index 00000000..1235c1f0
--- /dev/null
+++ b/src/masked_softmax.h
@@ -0,0 +1,63 @@
+// Masked categorical head math (bloodbowl-rl port; 4.0 exact-joint patch).
+//
+// Disabled categories are excluded from the log-normalizer, can never be
+// sampled, and contribute no entropy and no gradient. Upstream 5.0 instead
+// substituted a -1e4 logit, which keeps disabled categories in the
+// distribution whenever legal logits approach that magnitude.
+//
+// Host-testable: define __host__/__device__/precision_t/to_float before including.
+#pragma once
+#include <math.h>
+
+// Fills cache[0..A) with the masked logits (-INFINITY when disabled) and returns
+// log(sum over enabled categories of exp(logit)); -INFINITY for empty support.
+__host__ __device__ static inline float puf_masked_logsumexp(
+        const precision_t* logits, int logits_base, int logits_offset, int A,
+        const precision_t* mask, int mask_base, float* cache) {
+    float max_logit = -INFINITY;
+    float sum = 0.0f;
+    for (int a = 0; a < A; ++a) {
+        if (to_float(mask[mask_base + logits_offset + a]) == 0.0f) {
+            cache[a] = -INFINITY;
+            continue;
+        }
+        float l = to_float(logits[logits_base + logits_offset + a]);
+        cache[a] = l;
+        if (l > max_logit) {
+            sum *= exp(max_logit - l);
+            max_logit = l;
+        }
+        sum += exp(l - max_logit);
+    }
+    return max_logit + log(sum);
+}
+
+// Entropy of one head from log-probabilities, enabled categories only.
+__host__ __device__ static inline float puf_masked_head_entropy(
+        const float* logps, const precision_t* mask, int A) {
+    float ent = 0.0f;
+    for (int j = 0; j < A; ++j) {
+        if (to_float(mask[j]) == 0.0f) {
+            continue;
+        }
+        ent -= exp(logps[j]) * logps[j];
+    }
+    return ent;
+}
+
+// In: grad[0..A) holds log-probabilities. Out: gradient of
+// d_logp * logp(act) - ent_coef * entropy w.r.t. the logits; zero when disabled.
+__host__ __device__ static inline void puf_masked_head_grad(float* grad,
+        const precision_t* mask, int A, int act, float d_logp,
+        float d_entropy_term, float ent) {
+    for (int j = 0; j < A; ++j) {
+        if (to_float(mask[j]) == 0.0f) {
+            grad[j] = 0.0f;
+            continue;
+        }
+        float logp = grad[j];
+        float p = exp(logp);
+        grad[j] = ((j == act ? 1.0f : 0.0f) - p) * d_logp
+            + d_entropy_term * p * (-ent - logp);
+    }
+}
