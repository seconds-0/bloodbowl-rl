diff --git a/src/train_rows.h b/src/train_rows.h
new file mode 100644
index 00000000..cc20de0d
--- /dev/null
+++ b/src/train_rows.h
@@ -0,0 +1,43 @@
+// Learner-row selection for the PPO update (bloodbowl-rl port).
+//
+// Upstream 5.0 transposes every agent row of the rollout into the training
+// buffer, including rows played by frozen historical policies (selfplay /
+// league banks), whose actions and log-probabilities come from a different
+// policy. This gathers only learner rows (policy 0: the first
+// policy_layout[1] rows of each buffer) into the training buffer, in a rotated
+// order, so frozen rows never reach advantages, the value loss or the policy
+// gradient.
+//
+// Minibatches stay contiguous row slices [mb*mb_segs, +mb_segs) of the
+// gathered buffer. When the eligible count is not a multiple of mb_segs the
+// map wraps into a pad region of mb_segs rows, so every slice is in bounds.
+// The start row rotates by total_minibatches*mb_segs each epoch, so with
+// replay_ratio < 1 every learner row is still visited (upstream always
+// trained rows [0, rr*total) and never the rest).
+#pragma once
+
+static inline int puf_train_pad_rows(int eligible, int mb_segs) {
+    return (eligible % mb_segs) ? mb_segs : 0;
+}
+
+static inline int puf_train_eligible_row(int k, int primary_per_buf, int agents_per_buf) {
+    return (k / primary_per_buf) * agents_per_buf + (k % primary_per_buf);
+}
+
+static inline long puf_train_epoch_start(long epoch, int total_minibatches,
+        int mb_segs, int eligible) {
+    if (eligible <= 0) {
+        return 0;
+    }
+    long step = ((long)total_minibatches * (long)mb_segs) % eligible;
+    return (epoch % eligible) * step % eligible;
+}
+
+// map[r] = physical rollout row for gathered row r, r in [0, total_rows).
+static inline void puf_fill_train_row_map(int* map, int total_rows, int eligible,
+        int primary_per_buf, int agents_per_buf, long epoch_start) {
+    for (int r = 0; r < total_rows; ++r) {
+        int k = (int)((epoch_start + r) % eligible);
+        map[r] = puf_train_eligible_row(k, primary_per_buf, agents_per_buf);
+    }
+}
