+// Gather initial recurrent state rows: dst (L, A, H) row r <- src row row_map[r].
+__global__ void gather_state_rows(precision_t* dst, const precision_t* src,
+        const int* row_map, int L, int A, int H, int R) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = L * R * H;
+    if (idx >= total) {
+        return;
+    }
+    int l = idx / (R * H);
+    int r = (idx / H) % R;
+    int h = idx % H;
+    dst[(long)l * A * H + (long)r * H + h] =
+        src[(long)l * A * H + (long)row_map[r] * H + h];
+}
