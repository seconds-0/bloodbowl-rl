+// Gather rollout rows (T, B, C) into training rows (R, T, C) through row_map.
+// Replaces the full transpose so frozen-policy rows never reach PPO.
+__global__ void gather_rows_102(precision_t* dst, const precision_t* src,
+        const int* row_map, int T, int B, int C, int R) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = R * T * C;
+    if (idx >= total) {
+        return;
+    }
+    int r = idx / (T * C);
+    int rem = idx % (T * C);
+    int t = rem / C;
+    int c = rem % C;
+    dst[idx] = src[(long)t * B * C + (long)row_map[r] * C + c];
+}
