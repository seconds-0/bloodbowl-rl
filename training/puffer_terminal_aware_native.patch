+struct TerminalQualificationBuffer {
+    void* data = nullptr;
+    explicit TerminalQualificationBuffer(size_t bytes) {
+        require_cuda_success(cudaMalloc(&data, bytes),
+            "terminal derivative buffer allocation failed");
+    }
+    ~TerminalQualificationBuffer() {
+        if (data != nullptr) cudaFree(data);
+    }
+    TerminalQualificationBuffer(const TerminalQualificationBuffer&) = delete;
+    TerminalQualificationBuffer& operator=(const TerminalQualificationBuffer&) = delete;
+};
