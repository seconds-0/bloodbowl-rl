+static void require_complete_memory_batch(PuffeRL& pufferl) {
+    if (!pufferl.lifecycle_enforced) return;
+    int buffers = pufferl.hypers.num_buffers;
+    std::vector<int> initial_valid(buffers);
+    std::vector<int> tail_valid(buffers);
+    require_cuda_success(cudaMemcpy(initial_valid.data(),
+        pufferl.segment_initial_valid.data, buffers * sizeof(int),
+        cudaMemcpyDeviceToHost), "segment-initial lifecycle copy failed");
+    require_cuda_success(cudaMemcpy(tail_valid.data(), pufferl.tail_valid.data,
+        buffers * sizeof(int), cudaMemcpyDeviceToHost),
+        "tail lifecycle copy failed");
+    for (int buffer = 0; buffer < buffers; buffer++) {
+        if (initial_valid[buffer] != 1 || tail_valid[buffer] != 1) {
+            throw std::runtime_error(
+                "training requires exactly one segment-initial record and "
+                "one tail record per buffer");
+        }
+    }
+}
