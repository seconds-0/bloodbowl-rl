+void qualification_require_fp32_memory(PuffeRL& pufferl) {
+    require_idle_entropy_transaction(pufferl);
+    if (USE_BF16) {
+        throw std::runtime_error(
+            "terminal-aware memory qualification requires fp32");
+    }
+}
+
+std::vector<float> qualification_binary_terminals(
+        py::sequence values, int expected) {
+    if (py::len(values) != expected) {
+        throw std::runtime_error(
+            "qualification terminal vector must match total_agents");
+    }
+    std::vector<float> result(expected);
+    for (int i = 0; i < expected; i++) {
+        float value = py::cast<float>(values[i]);
+        if (value != 0.0f && value != 1.0f) {
+            throw std::runtime_error(
+                "qualification terminal values must be exactly zero or one");
+        }
+        result[i] = value;
+    }
+    return result;
+}
+
+void qualification_set_terminals(
+        py::object pufferl_obj, py::sequence terminals) {
+    PuffeRL& pufferl = pufferl_obj.cast<PuffeRL&>();
+    qualification_require_fp32_memory(pufferl);
+    std::vector<float> host = qualification_binary_terminals(
+        terminals, pufferl.hypers.total_agents);
+    require_cuda_success(cudaMemcpy(pufferl.env.terminals.data, host.data(),
+        host.size() * sizeof(float), cudaMemcpyHostToDevice),
+        "qualification terminal injection failed");
+}
+
+void qualification_set_memory_fixture(
+        py::object pufferl_obj,
+        py::array_t<float, py::array::c_style> state_values,
+        py::array_t<float, py::array::c_style> observation_terminals) {
+    PuffeRL& pufferl = pufferl_obj.cast<PuffeRL&>();
+    qualification_require_fp32_memory(pufferl);
+    int rows = pufferl.hypers.total_agents;
+    auto state = state_values.request();
+    auto terminals = observation_terminals.request();
+    if (state.ndim != 3 || state.shape[0] != pufferl.hypers.num_layers ||
+            state.shape[1] != rows ||
+            state.shape[2] != pufferl.hypers.hidden_size) {
+        throw std::runtime_error(
+            "qualification state fixture must have shape "
+            "[num_layers,total_agents,hidden_size]");
+    }
+    if (terminals.ndim != 2 ||
+            terminals.shape[0] != pufferl.hypers.horizon ||
+            terminals.shape[1] != rows) {
+        throw std::runtime_error(
+            "qualification terminal fixture must have shape "
+            "[horizon,total_agents]");
+    }
+    const float* values = static_cast<const float*>(state.ptr);
+    const float* terminal_values = static_cast<const float*>(terminals.ptr);
+    int64_t state_elements = static_cast<int64_t>(pufferl.hypers.num_layers)
+        * rows * pufferl.hypers.hidden_size;
+    for (int64_t i = 0; i < state_elements; i++) {
+        if (!std::isfinite(values[i])) {
+            throw std::runtime_error(
+                "qualification state fixture values must be finite");
+        }
+    }
+    int64_t terminal_elements = static_cast<int64_t>(pufferl.hypers.horizon)
+        * rows;
+    for (int64_t i = 0; i < terminal_elements; i++) {
+        if (terminal_values[i] != 0.0f && terminal_values[i] != 1.0f) {
+            throw std::runtime_error(
+                "qualification terminal fixture values must be exactly zero or one");
+        }
+    }
+    std::vector<int> initial_valid(pufferl.hypers.num_buffers);
+    std::vector<int> tail_valid(pufferl.hypers.num_buffers);
+    require_cuda_success(cudaMemcpy(initial_valid.data(),
+        pufferl.segment_initial_valid.data,
+        initial_valid.size() * sizeof(int), cudaMemcpyDeviceToHost),
+        "qualification initial-valid read failed");
+    require_cuda_success(cudaMemcpy(tail_valid.data(), pufferl.tail_valid.data,
+        tail_valid.size() * sizeof(int), cudaMemcpyDeviceToHost),
+        "qualification tail-valid read failed");
+    for (int buffer = 0; buffer < pufferl.hypers.num_buffers; buffer++) {
+        if (initial_valid[buffer] != 0 || tail_valid[buffer] != 0) {
+            throw std::runtime_error(
+                "qualification fixture requires fresh lifecycle state");
+        }
+    }
+    int per_buffer = rows / pufferl.hypers.num_buffers;
+    for (int bank = 0; bank < 1 + pufferl.num_frozen_banks; bank++) {
+        PrecisionTensor* states = bank == 0 ? pufferl.buffer_states
+            : pufferl.frozen_banks[bank - 1].buffer_states;
+        int local_start = pufferl.bank_layout == nullptr
+            ? 0 : pufferl.bank_layout[bank];
+        int local_end = pufferl.bank_layout == nullptr
+            ? per_buffer : pufferl.bank_layout[bank + 1];
+        int active = local_end - local_start;
+        for (int buffer = 0; buffer < pufferl.hypers.num_buffers; buffer++) {
+            int layers = states[buffer].shape[0];
+            int hidden = states[buffer].shape[2];
+            std::vector<precision_t> host(numel(states[buffer].shape),
+                from_float(0.0f));
+            for (int layer = 0; layer < layers; layer++) {
+                for (int row = 0; row < active; row++) {
+                    for (int column = 0; column < hidden; column++) {
+                        int physical = buffer * per_buffer + local_start + row;
+                        float value = values[(layer * rows + physical) * hidden
+                            + column];
+                        host[(layer * states[buffer].shape[1] + row) * hidden
+                            + column] = from_float(value);
+                    }
+                }
+            }
+            require_cuda_success(cudaMemcpy(states[buffer].data, host.data(),
+                host.size() * sizeof(precision_t), cudaMemcpyHostToDevice),
+                "qualification behavior-state injection failed");
+        }
+    }
+    require_cuda_success(cudaMemcpy(
+        pufferl.qualification_terminal_fixture.data, terminal_values,
+        terminal_elements * sizeof(float), cudaMemcpyHostToDevice),
+        "qualification terminal fixture injection failed");
+}
+
+void qualification_run_rollout_step(
+        py::object pufferl_obj, int buffer, int timestep) {
+    PuffeRL& pufferl = pufferl_obj.cast<PuffeRL&>();
+    qualification_require_fp32_memory(pufferl);
+    if (buffer < 0 || buffer >= pufferl.hypers.num_buffers ||
+            timestep < 0 || timestep >= pufferl.hypers.horizon) {
+        throw std::runtime_error("qualification rollout step is out of bounds");
+    }
+    if (timestep == 0) {
+        int valid = -1;
+        require_cuda_success(cudaMemcpy(&valid,
+            pufferl.segment_initial_valid.data + buffer, sizeof(int),
+            cudaMemcpyDeviceToHost), "qualification initial-valid read failed");
+        if (valid != 0) throw std::runtime_error(
+            "qualification rollout would overwrite segment initial state");
+    }
+    require_cuda_success(cudaMemcpyAsync(pufferl.env.terminals.data,
+        pufferl.qualification_terminal_fixture.data
+            + static_cast<int64_t>(timestep) * pufferl.hypers.total_agents,
+        pufferl.hypers.total_agents * sizeof(float),
+        cudaMemcpyDeviceToDevice, pufferl.streams[buffer]),
+        "qualification rollout terminal injection failed");
+    tl_stream = pufferl.streams[buffer];
+    net_callback_wrapper(&pufferl, buffer, timestep);
+    require_cuda_success(cudaStreamSynchronize(tl_stream),
+        "qualification rollout-step synchronization failed");
+}
+
+void qualification_run_tail(py::object pufferl_obj, int buffer) {
+    PuffeRL& pufferl = pufferl_obj.cast<PuffeRL&>();
+    qualification_require_fp32_memory(pufferl);
+    if (buffer < 0 || buffer >= pufferl.hypers.num_buffers) {
+        throw std::runtime_error("qualification tail buffer is out of bounds");
+    }
+    int valid = -1;
+    require_cuda_success(cudaMemcpy(&valid, pufferl.tail_valid.data + buffer,
+        sizeof(int), cudaMemcpyDeviceToHost),
+        "qualification tail-valid read failed");
+    if (valid != 0) throw std::runtime_error(
+        "qualification tail would overwrite unconsumed tail state");
+    tl_stream = pufferl.streams[buffer];
+    tail_callback_wrapper(&pufferl, buffer);
+    require_cuda_success(cudaStreamSynchronize(tl_stream),
+        "qualification tail synchronization failed");
+}
+
+void qualification_set_segment_initial_row(
+        py::object pufferl_obj, int row, float value) {
+    PuffeRL& pufferl = pufferl_obj.cast<PuffeRL&>();
+    qualification_require_fp32_memory(pufferl);
+    if (row < 0 || row >= pufferl.hypers.total_agents || !std::isfinite(value)) {
+        throw std::runtime_error("qualification initial-state mutation is invalid");
+    }
+    int layers = pufferl.hypers.num_layers;
+    int hidden = pufferl.hypers.hidden_size;
+    std::vector<precision_t> host(hidden, from_float(value));
+    for (int layer = 0; layer < layers; layer++) {
+        precision_t* dst = pufferl.segment_initial_states.data
+            + (layer * pufferl.hypers.total_agents + row) * hidden;
+        require_cuda_success(cudaMemcpy(dst, host.data(),
+            hidden * sizeof(precision_t), cudaMemcpyHostToDevice),
+            "qualification initial-state mutation failed");
+    }
+}
