+py::dict qualification_terminal_mingru_derivatives(
+        py::array_t<float, py::array::c_style> terminal_mask,
+        size_t max_bytes = 16ULL << 20) {
+    constexpr int B = 2, H = 5;
+    if (USE_BF16 || max_bytes == 0 || max_bytes > (16ULL << 20)) {
+        throw std::runtime_error(
+            "terminal min-GRU derivative fixture requires bounded fp32");
+    }
+    auto terminal_info = terminal_mask.request();
+    if (terminal_info.ndim != 2 || terminal_info.shape[0] != B ||
+            terminal_info.shape[1] < 1 || terminal_info.shape[1] > 64) {
+        throw std::runtime_error(
+            "terminal derivative mask must have shape [2,T], 1 <= T <= 64");
+    }
+    int T = terminal_info.shape[1];
+    const float* terminal_host = static_cast<const float*>(terminal_info.ptr);
+    for (int i = 0; i < B * T; i++) {
+        if (terminal_host[i] != 0.0f && terminal_host[i] != 1.0f) {
+            throw std::runtime_error(
+                "terminal derivative mask values must be exactly zero or one");
+        }
+    }
+    size_t sequence = static_cast<size_t>(B) * T * H;
+    TerminalQualificationBuffer combined(3 * sequence * sizeof(precision_t));
+    TerminalQualificationBuffer inputs(sequence * sizeof(precision_t));
+    TerminalQualificationBuffer initial(B * H * sizeof(precision_t));
+    TerminalQualificationBuffer terminals(B * T * sizeof(precision_t));
+    TerminalQualificationBuffer outputs(sequence * sizeof(precision_t));
+    TerminalQualificationBuffer final_state(B * H * sizeof(precision_t));
+    TerminalQualificationBuffer history(
+        static_cast<size_t>(B) * (T + 1) * H * sizeof(float));
+    TerminalQualificationBuffer grad_combined(3 * sequence * sizeof(precision_t));
+    TerminalQualificationBuffer grad_inputs(sequence * sizeof(precision_t));
+    TerminalQualificationBuffer grad_initial(B * H * sizeof(precision_t));
+    TerminalQualificationBuffer grad_outputs(sequence * sizeof(precision_t));
+    TerminalQualificationBuffer grad_next(B * H * sizeof(precision_t));
+    std::vector<float> hc(3 * sequence), hi(sequence), hs(B * H), hgo(sequence);
+    for (size_t i = 0; i < hc.size(); i++)
+        hc[i] = 0.7f * sinf(0.17f * (i + 1)) + 0.13f;
+    for (size_t i = 0; i < hi.size(); i++)
+        hi[i] = 0.5f * cosf(0.11f * (i + 2));
+    for (size_t i = 0; i < hs.size(); i++)
+        hs[i] = 0.2f + 0.3f * fabsf(sinf(0.07f * (i + 3)));
+    for (size_t i = 0; i < hgo.size(); i++)
+        hgo[i] = 0.4f * sinf(0.19f * (i + 4));
+    cudaStream_t stream = 0;
+    require_cuda_success(cudaMemcpyAsync(combined.data, hc.data(),
+        hc.size() * sizeof(float), cudaMemcpyHostToDevice, stream),
+        "terminal derivative combined upload failed");
+    require_cuda_success(cudaMemcpyAsync(inputs.data, hi.data(),
+        hi.size() * sizeof(float), cudaMemcpyHostToDevice, stream),
+        "terminal derivative input upload failed");
+    require_cuda_success(cudaMemcpyAsync(initial.data, hs.data(),
+        hs.size() * sizeof(float), cudaMemcpyHostToDevice, stream),
+        "terminal derivative state upload failed");
+    require_cuda_success(cudaMemcpyAsync(terminals.data, terminal_host,
+        B * T * sizeof(float), cudaMemcpyHostToDevice, stream),
+        "terminal derivative mask upload failed");
+    require_cuda_success(cudaMemcpyAsync(grad_outputs.data, hgo.data(),
+        hgo.size() * sizeof(float), cudaMemcpyHostToDevice, stream),
+        "terminal derivative output-gradient upload failed");
+    require_cuda_success(cudaMemsetAsync(grad_next.data, 0,
+        B * H * sizeof(float), stream),
+        "terminal derivative final-state gradient reset failed");
+    PrefixScan scan = {
+        .combined_ptr = static_cast<precision_t*>(combined.data),
+        .state_ptr = static_cast<precision_t*>(initial.data),
+        .input_ptr = static_cast<precision_t*>(inputs.data),
+        .terminal_ptr = static_cast<precision_t*>(terminals.data),
+        .B = B, .T = T, .H = H,
+        .state_history = {.data = static_cast<float*>(history.data),
+            .shape = {B, T + 1, H}},
+        .out = {.data = static_cast<precision_t*>(outputs.data),
+            .shape = {B, T, H}},
+        .next_state = {.data = static_cast<precision_t*>(final_state.data),
+            .shape = {B, 1, H}},
+        .grad_combined = {.data = static_cast<precision_t*>(grad_combined.data),
+            .shape = {B, T, 3 * H}},
+        .grad_state = {.data = static_cast<precision_t*>(grad_initial.data),
+            .shape = {B, 1, H}},
+        .grad_input = {.data = static_cast<precision_t*>(grad_inputs.data),
+            .shape = {B, T, H}},
+    };
+    mingru_scan_forward<<<grid_size(B * H), BLOCK_SIZE, 0, stream>>>(scan);
+    mingru_scan_backward<<<grid_size(B * H), BLOCK_SIZE, 0, stream>>>(
+        scan, static_cast<precision_t*>(grad_outputs.data),
+        static_cast<precision_t*>(grad_next.data));
+    require_cuda_success(cudaStreamSynchronize(stream),
+        "terminal min-GRU derivative fixture execution failed");
+    size_t used = 0;
+    auto tensor = [&](const char* name, void* data,
+            std::initializer_list<int64_t> shape) {
+        PrecisionTensor value = {.data = static_cast<precision_t*>(data)};
+        int dim = 0;
+        for (int64_t extent : shape) value.shape[dim++] = extent;
+        return qualification_precision_tensor(name, value, &used, max_bytes);
+    };
+    py::dict tensors_out;
+    tensors_out["combined"] = tensor("combined", combined.data, {B, T, 3 * H});
+    tensors_out["inputs"] = tensor("inputs", inputs.data, {B, T, H});
+    tensors_out["initial_state"] = tensor("initial_state", initial.data, {B, H});
+    tensors_out["terminals"] = tensor("terminals", terminals.data, {B, T});
+    tensors_out["outputs"] = tensor("outputs", outputs.data, {B, T, H});
+    tensors_out["final_state"] = tensor("final_state", final_state.data, {B, H});
+    tensors_out["grad_outputs"] = tensor("grad_outputs", grad_outputs.data, {B, T, H});
+    tensors_out["grad_combined"] = tensor(
+        "grad_combined", grad_combined.data, {B, T, 3 * H});
+    tensors_out["grad_inputs"] = tensor("grad_inputs", grad_inputs.data, {B, T, H});
+    tensors_out["grad_initial_state"] = tensor(
+        "grad_initial_state", grad_initial.data, {B, H});
+    py::dict result;
+    result["contract"] = "terminal-mingru-derivatives-fp32-v1";
+    result["B"] = B; result["T"] = T; result["H"] = H;
+    result["used_bytes"] = used;
+    result["tensors"] = tensors_out;
+    return result;
+}
