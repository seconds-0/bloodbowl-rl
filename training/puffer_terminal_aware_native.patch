+py::dict qualification_memory_snapshot(
+        py::object pufferl_obj,
+        size_t max_bytes = QUALIFICATION_MAX_SNAPSHOT_BYTES) {
+    PuffeRL& pufferl = pufferl_obj.cast<PuffeRL&>();
+    qualification_require_fp32_memory(pufferl);
+    if (max_bytes == 0 || max_bytes > QUALIFICATION_MAX_SNAPSHOT_BYTES) {
+        throw std::runtime_error("invalid memory snapshot byte limit");
+    }
+    require_cuda_success(cudaDeviceSynchronize(),
+        "qualification memory snapshot synchronization failed");
+    size_t used = 0;
+    py::dict tensors;
+    tensors["segment_initial_states"] = qualification_precision_tensor(
+        "segment_initial_states", pufferl.segment_initial_states, &used, max_bytes);
+    tensors["rollout_observation_terminals"] = qualification_precision_tensor(
+        "rollout_observation_terminals", pufferl.rollouts.terminals, &used, max_bytes);
+    tensors["controlled_observation_terminals"] = qualification_precision_tensor(
+        "controlled_observation_terminals",
+        pufferl.qualification_terminal_fixture, &used, max_bytes);
+    tensors["mb_initial_states"] = qualification_precision_tensor(
+        "mb_initial_states", pufferl.train_buf.mb_state, &used, max_bytes);
+    tensors["mb_observation_terminals"] = qualification_precision_tensor(
+        "mb_observation_terminals", pufferl.train_buf.mb_terminals, &used, max_bytes);
+    tensors["segment_initial_valid"] = qualification_int_tensor(
+        "segment_initial_valid", pufferl.segment_initial_valid, &used, max_bytes);
+    tensors["tail_valid"] = qualification_int_tensor(
+        "tail_valid", pufferl.tail_valid, &used, max_bytes);
+    tensors["tail_values"] = qualification_precision_tensor(
+        "tail_values", pufferl.tail_values, &used, max_bytes);
+    tensors["tail_terminals"] = qualification_precision_tensor(
+        "tail_terminals", pufferl.tail_terminals, &used, max_bytes);
+    py::list behavior_states;
+    py::list tail_input_states;
+    py::list tail_work_states;
+    int per_buffer = pufferl.hypers.total_agents / pufferl.hypers.num_buffers;
+    for (int bank = 0; bank < 1 + pufferl.num_frozen_banks; bank++) {
+        PrecisionTensor* behavior = bank == 0 ? pufferl.buffer_states
+            : pufferl.frozen_banks[bank - 1].buffer_states;
+        PrecisionTensor* tail_input = bank == 0 ? pufferl.tail_input_states
+            : pufferl.frozen_banks[bank - 1].tail_input_states;
+        PrecisionTensor* tail_work = bank == 0 ? pufferl.tail_states
+            : pufferl.frozen_banks[bank - 1].tail_states;
+        int start = pufferl.bank_layout == nullptr ? 0 : pufferl.bank_layout[bank];
+        int end = pufferl.bank_layout == nullptr ? per_buffer : pufferl.bank_layout[bank + 1];
+        for (int buffer = 0; buffer < pufferl.hypers.num_buffers; buffer++) {
+            py::dict b;
+            b["bank"] = bank;
+            b["buffer"] = buffer;
+            b["physical_row_start"] = buffer * per_buffer + start;
+            b["active_rows"] = end - start;
+            b["tensor"] = qualification_precision_tensor(
+                "behavior_state", behavior[buffer], &used, max_bytes);
+            behavior_states.append(b);
+            py::dict ti;
+            ti["bank"] = bank;
+            ti["buffer"] = buffer;
+            ti["physical_row_start"] = buffer * per_buffer + start;
+            ti["active_rows"] = end - start;
+            ti["tensor"] = qualification_precision_tensor(
+                "tail_input_state", tail_input[buffer], &used, max_bytes);
+            tail_input_states.append(ti);
+            py::dict tw;
+            tw["bank"] = bank;
+            tw["buffer"] = buffer;
+            tw["physical_row_start"] = buffer * per_buffer + start;
+            tw["active_rows"] = end - start;
+            tw["tensor"] = qualification_precision_tensor(
+                "tail_work_state", tail_work[buffer], &used, max_bytes);
+            tail_work_states.append(tw);
+        }
+    }
+    py::dict result;
+    result["contract"] = "terminal-aware-tbptt-v1";
+    result["used_bytes"] = used;
+    result["tensors"] = tensors;
+    result["behavior_states"] = behavior_states;
+    result["tail_input_states"] = tail_input_states;
+    result["tail_work_states"] = tail_work_states;
+    return result;
+}
