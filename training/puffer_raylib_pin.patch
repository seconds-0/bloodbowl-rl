@@ -54,6 +54,8 @@
 PLATFORM="$(uname -s)"
 if [ "$PLATFORM" = "Linux" ]; then
     RAYLIB_NAME='raylib-5.5_linux_amd64'
+    RAYLIB_ARCHIVE_SHA256='3d95ef03d5b38dfa55c0a16ca122d382134b078f0e5b270b52fe7eae0549c000'
+    RAYLIB_LIBRARY_SHA256='3323cbf14ec6e640e19d63e230e68c3a530be3e9a9d416435eab82160e9e9ccc'
     OMP_LIB=-lomp5
     CPU_OMP_COMPILE_FLAGS=(-fopenmp)
     CPU_OMP_LINK_FLAGS=(-fopenmp "$OMP_LIB")
@@ -63,6 +65,8 @@
     SHARED_LDFLAGS=(-Bsymbolic-functions)
 else
     RAYLIB_NAME='raylib-5.5_macos'
+    RAYLIB_ARCHIVE_SHA256='930c67b676963c6cffbd965814664523081ecbf3d30fc9df4211d0064aa6ba39'
+    RAYLIB_LIBRARY_SHA256='5517f19555ce6e19540ac534bb5d5bf08ba45660d14642db4878f079a9f1b7da'
     OMP_LIB=-lomp
     CPU_OMP_COMPILE_FLAGS=()
     CPU_OMP_LINK_FLAGS=()
@@ -82,14 +86,94 @@
     -Wno-error=array-parameter
 )
 
+sha256_path() {
+    if command -v sha256sum >/dev/null 2>&1; then
+        sha256sum "$1" | awk '{print $1}'
+    else
+        shasum -a 256 "$1" | awk '{print $1}'
+    fi
+}
+
+require_sha256() {
+    local path=$1 expected=$2 label=$3
+    local observed
+    if [ ! -f "$path" ] || [ -L "$path" ]; then
+        echo "Error: $label is not a regular non-link file: $path"
+        exit 1
+    fi
+    observed="$(sha256_path "$path")" || {
+        echo "Error: cannot hash $label at $path"
+        exit 1
+    }
+    if [ "$observed" != "$expected" ]; then
+        echo "Error: $label SHA-256 differs: $observed != $expected"
+        exit 1
+    fi
+}
+
 download() {
     local name=$1 url=$2
-    [ -d "$name" ] && return
-    echo "Downloading $name..."
+    local archive_sha256=${3:-} library_sha256=${4:-}
+    local archive archive_directory
     case "$url" in
-        *.zip) curl -sL "$url" -o "$name.zip" && unzip -q "$name.zip" && rm "$name.zip" ;;
-        *)     curl -sL "$url" -o "$name.tar.gz" && tar xf "$name.tar.gz" && rm "$name.tar.gz" ;;
+        *.zip) archive="$name.zip" ;;
+        *)     archive="$name.tar.gz" ;;
     esac
+    if [ -n "$archive_sha256" ]; then
+        case "$name" in
+            raylib-5.5_linux_amd64|raylib-5.5_macos) ;;
+            *)
+                echo "Error: pinned archive requested for unexpected input $name"
+                exit 1
+                ;;
+        esac
+        archive_directory='raylib-archives'
+        if [ -e "$archive_directory" ] || [ -L "$archive_directory" ]; then
+            if [ ! -d "$archive_directory" ] || [ -L "$archive_directory" ]; then
+                echo "Error: Raylib archive cache is not a real directory"
+                exit 1
+            fi
+        else
+            mkdir "$archive_directory"
+        fi
+        archive="$archive_directory/$archive"
+        if [ -e "$name" ] || [ -L "$name" ]; then
+            if [ ! -d "$name" ] || [ -L "$name" ]; then
+                echo "Error: existing Raylib input is not a real directory"
+                exit 1
+            fi
+        fi
+        if [ -e "$archive" ] || [ -L "$archive" ]; then
+            require_sha256 "$archive" "$archive_sha256" "Raylib archive"
+        else
+            echo "Downloading $name..."
+            curl --disable --fail --silent --show-error --location \
+                "$url" --output "$archive"
+            require_sha256 "$archive" "$archive_sha256" "Raylib archive"
+        fi
+        if [ -e "$name" ]; then
+            rm -rf "./$name"
+        fi
+    elif [ -d "$name" ]; then
+        return
+    else
+        echo "Downloading $name..."
+        curl --disable --fail --silent --show-error --location \
+            "$url" --output "$archive"
+    fi
+    if [ -n "$archive_sha256" ]; then
+        require_sha256 "$archive" "$archive_sha256" "Raylib archive"
+    fi
+    case "$archive" in
+        *.zip) unzip -q "$archive" ;;
+        *)     tar xf "$archive" ;;
+    esac
+    if [ -n "$library_sha256" ]; then
+        require_sha256 \
+            "$name/lib/libraylib.a" "$library_sha256" "Raylib library"
+    else
+        rm "$archive"
+    fi
 }
 
 RAYLIB_URL="https://github.com/raysan5/raylib/releases/download/5.5"
@@ -97,7 +181,9 @@
     RAYLIB_NAME='raylib-5.5_webassembly'
     download "$RAYLIB_NAME" "$RAYLIB_URL/$RAYLIB_NAME.zip"
 else
-    download "$RAYLIB_NAME" "$RAYLIB_URL/$RAYLIB_NAME.tar.gz"
+    download \
+        "$RAYLIB_NAME" "$RAYLIB_URL/$RAYLIB_NAME.tar.gz" \
+        "$RAYLIB_ARCHIVE_SHA256" "$RAYLIB_LIBRARY_SHA256"
 fi
 
 RAYLIB_A="$RAYLIB_NAME/lib/libraylib.a"
@@ -208,6 +294,12 @@ elif [ "$MODE" = "web" ]; then
     exit 0
 fi
 
+BUILD_PYTHON="${PUFFER_BUILD_PYTHON:-python}"
