[Unit]
Description=Tick the Blood Bowl chain supervisor (%i)

[Timer]
# Five minutes, as for campaign-supervisor@.timer: a tick is a pgrep plus a
# few stat() calls, and a miss costs at most five minutes of idle GPU between
# stages. Persistent=true so a tick that was due while the box was down fires
# once on boot. Do not shorten this without raising StartLimitBurst in
# chain-supervisor@.service.
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=true
Unit=chain-supervisor@%i.service
# Once a chain halts or completes, its ticks go quiet (no state write) but
# this timer keeps firing. Every terminal tick logs the exact command to stop it:
#   systemctl --user disable --now chain-supervisor@<campaign>.timer

[Install]
WantedBy=timers.target
