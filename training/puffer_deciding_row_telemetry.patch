+// LOCAL PATCH (bloodbowl-rl, deciding-row telemetry): true when some head of
+// the stored conditional support enables more than one action, which under
+// exact joint masks is exactly "the joint support has more than one action".
+__device__ __forceinline__ bool row_has_choice(
+        const precision_t* mask, int mask_base, const int* act_sizes, int num_atns) {
+    int logits_offset = 0;
+    for (int h = 0; h < num_atns; ++h) {
+        int enabled = 0;
+        for (int j = 0; j < act_sizes[h]; ++j) {
+            if (action_enabled(mask, mask_base, logits_offset, j) && ++enabled > 1) {
+                return true;
+            }
+        }
+        logits_offset += act_sizes[h];
+    }
+    return false;
+}
