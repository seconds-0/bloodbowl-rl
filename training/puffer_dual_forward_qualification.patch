+// Qualification-only forward attribution. This never mutates weights, optimizer,
+// rollout storage, or the production activation buffers.
+__global__ void qualification_gather_timestep(
+        const precision_t* __restrict__ source, precision_t* __restrict__ output,
+        int B, int T, int width, int t, int source_b_start) {
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= B * width) return;
+    int b = i / width, col = i % width;
+    output[i] = source[((b + source_b_start) * T + t) * width + col];
+}
+
+__global__ void qualification_scatter_timestep(
+        const precision_t* __restrict__ source, precision_t* __restrict__ output,
+        int B, int T, int width, int t) {
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= B * width) return;
+    int b = i / width, col = i % width;
+    output[(b * T + t) * width + col] = source[i];
+}
+
+__global__ void qualification_mingru_direct_step(
+        const precision_t* __restrict__ combined,
+        const precision_t* __restrict__ input,
+        precision_t* __restrict__ state,
+        precision_t* __restrict__ output, int B, int H) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= B * H) return;
+    int h = idx % H;
+    float previous = to_float(state[idx]);
+    // puf_mm rows are [hidden, gate, projection], each row contiguous.
+    int row = idx / H;
+    int c = row * 3 * H + h;
+    float hidden = to_float(combined[c]);
+    float gate = to_float(combined[c + H]);
+    float proj = to_float(combined[c + 2 * H]);
+    float g = sigmoid(gate);
+    float candidate = hidden >= 0.0f ? hidden + 0.5f : fast_sigmoid(hidden);
+    float current = to_float(from_float(lerp(previous, candidate, g)));
+    state[idx] = from_float(current);
+    float p = sigmoid(proj);
+    output[idx] = from_float(p * current + (1.0f - p) * to_float(input[idx]));
+}
+
+__global__ void qualification_select_terminal_rows(
+        const precision_t* __restrict__ terminals,
+        const int* __restrict__ selected,
+        precision_t* __restrict__ output, int B, int T) {
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= B * T) return;
+    int b = i / T, t = i % T;
+    output[i] = terminals[selected[b] * T + t];
+}
+
+__global__ void qualification_per_head_logprobs(
+        const precision_t* __restrict__ logits, int logits_stride,
+        const precision_t* __restrict__ actions,
+        const precision_t* __restrict__ mask,
+        const int* __restrict__ act_sizes,
+        const precision_t* __restrict__ old_logprobs,
+        float* __restrict__ logprobs, float* __restrict__ total_logprobs,
+        float* __restrict__ ratios,
+        int rows, int heads, int mask_stride) {
+    int row = blockIdx.x * blockDim.x + threadIdx.x;
+    if (row >= rows) return;
+    int offset = 0;
+    float total = 0.0f;
+    for (int head = 0; head < heads; ++head) {
+        float lse, entropy, lp;
+        int act = static_cast<int>(to_float(actions[row * heads + head]));
+        ppo_discrete_head(logits, row * logits_stride, 1, offset,
+            act_sizes[head], act, mask, row * mask_stride,
+            &lse, &entropy, &lp);
+        logprobs[row * heads + head] = lp;
+        total += lp;
+        offset += act_sizes[head];
+    }
+    total_logprobs[row] = total;
+    ratios[row] = __expf(total - to_float(old_logprobs[row]));
+}
+
+struct QualificationCudaBuffer {
+    void* data = nullptr;
+    explicit QualificationCudaBuffer(size_t bytes) {
+        cudaError_t status = bytes == 0 ? cudaErrorInvalidValue
+            : cudaMalloc(&data, bytes);
+        if (status != cudaSuccess) {
+            size_t free_bytes = 0, total_bytes = 0;
+            cudaMemGetInfo(&free_bytes, &total_bytes);
+            throw std::runtime_error(std::string("dual-forward allocation failed: bytes=")
+                + std::to_string(bytes) + " free=" + std::to_string(free_bytes)
+                + " error=" + cudaGetErrorName(status));
+        }
+    }
+    ~QualificationCudaBuffer() { if (data != nullptr) cudaFree(data); }
+    QualificationCudaBuffer(const QualificationCudaBuffer&) = delete;
+    QualificationCudaBuffer& operator=(const QualificationCudaBuffer&) = delete;
+};
