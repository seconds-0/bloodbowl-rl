+        return false;
+    }
+    pufferl->tail_valid = {.shape = {num_buffers}};
+    alloc_register(tail_acts, &pufferl->tail_valid);
+
+    for (int i = 0; i < num_buffers; i++) {
+        pufferl->tail_activations[i] = policy_reg_rollout(
+            &pufferl->policy, pufferl->weights, tail_acts, primary_slice);
+        pufferl->tail_states[i] = {
+            .shape = {num_layers, primary_slice, hidden_size},
