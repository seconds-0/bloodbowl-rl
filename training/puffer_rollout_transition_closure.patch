+        alloc_register(tail_acts, &pufferl->tail_states[i]);
+    }
+    if (alloc_create(tail_acts) != cudaSuccess) {
+        return false;
     }
+
+    puf_zero(&pufferl->tail_observations, pufferl->default_stream);
+    puf_zero(&pufferl->tail_rewards, pufferl->default_stream);
+    puf_zero(&pufferl->tail_terminals, pufferl->default_stream);
+    puf_zero(&pufferl->tail_values, pufferl->default_stream);
+    cudaMemsetAsync(pufferl->tail_valid.data, 0,
+        num_buffers * sizeof(int), pufferl->default_stream);
