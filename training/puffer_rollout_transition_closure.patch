+    alloc_register(tail_acts, &pufferl->tail_values);
+
+    pufferl->tail_activations = (PolicyActivations*)calloc(
+        num_buffers, sizeof(PolicyActivations));
+    pufferl->tail_states = (PrecisionTensor*)calloc(
+        num_buffers, sizeof(PrecisionTensor));
+    if (pufferl->tail_activations == nullptr ||
