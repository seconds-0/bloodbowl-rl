+        .shape = {total_agents, input_size},
+    };
+    pufferl->tail_rewards = {.shape = {total_agents}};
+    pufferl->tail_terminals = {.shape = {total_agents}};
+    pufferl->tail_values = {.shape = {total_agents}};
+    alloc_register(tail_acts, &pufferl->tail_observations);
+    alloc_register(tail_acts, &pufferl->tail_rewards);
+    alloc_register(tail_acts, &pufferl->tail_terminals);
+    alloc_register(tail_acts, &pufferl->tail_values);
+
+    pufferl->tail_activations = (PolicyActivations*)calloc(
+        num_buffers, sizeof(PolicyActivations));
+    pufferl->tail_states = (PrecisionTensor*)calloc(
+        num_buffers, sizeof(PrecisionTensor));
+    if (pufferl->tail_activations == nullptr ||
+            pufferl->tail_states == nullptr) {
+        return false;
+    }
+    pufferl->tail_valid = {.shape = {num_buffers}};
+    alloc_register(tail_acts, &pufferl->tail_valid);
+
+    for (int i = 0; i < num_buffers; i++) {
+        pufferl->tail_activations[i] = policy_reg_rollout(
+            &pufferl->policy, pufferl->weights, tail_acts, primary_slice);
+        pufferl->tail_states[i] = {
+            .shape = {num_layers, primary_slice, hidden_size},
+        };
+        alloc_register(tail_acts, &pufferl->tail_states[i]);
+    }
+    if (alloc_create(tail_acts) != cudaSuccess) {
+        return false;
+    }
