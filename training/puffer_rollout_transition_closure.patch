+static void tail_forward_impl(PuffeRL* pufferl, int buf, cudaStream_t stream) {
+    HypersT& hypers = pufferl->hypers;
+    EnvBuf& env = pufferl->env;
+    int block_size = pufferl->vec->total_agents / hypers.num_buffers;
+    int start = buf * block_size;
+    int input_size = env.obs.shape[1];
+
+    int observation_count = block_size * input_size;
+    cast_dispatch(
+        pufferl->tail_observations.data + (long)start * input_size,
+        env.obs.data + (long)start * input_size,
+        observation_count, stream);
+    cast<<<grid_size(block_size), BLOCK_SIZE, 0, stream>>>(
+        pufferl->tail_rewards.data + start,
+        env.rewards.data + start, block_size);
+    cast<<<grid_size(block_size), BLOCK_SIZE, 0, stream>>>(
+        pufferl->tail_terminals.data + start,
+        env.terminals.data + start, block_size);
+
+    int num_banks = 1 + pufferl->num_frozen_banks;
+    for (int bank = 0; bank < num_banks; bank++) {
+        int bank_off = pufferl->bank_layout
+            ? pufferl->bank_layout[bank] : 0;
+        int bank_end = pufferl->bank_layout
+            ? pufferl->bank_layout[bank + 1] : block_size;
+        int bank_size = bank_end - bank_off;
+        if (bank_size == 0) continue;
+
+        Policy* policy;
+        PolicyWeights* weights;
+        PolicyActivations* activations;
+        PrecisionTensor* state;
+        if (bank == 0) {
+            policy = &pufferl->policy;
+            weights = &pufferl->weights;
+            activations = &pufferl->tail_activations[buf];
+            state = &pufferl->tail_states[buf];
+        } else {
+            WeightBank* frozen = &pufferl->frozen_banks[bank - 1];
+            policy = &frozen->policy;
+            weights = &frozen->weights;
+            activations = &frozen->tail_activations[buf];
+            state = &frozen->tail_states[buf];
+        }
+
+        int sub_start = start + bank_off;
+        PrecisionTensor observation = {
+            .data = pufferl->tail_observations.data
+                + (long)sub_start * input_size,
+            .shape = {bank_size, input_size},
+        };
+        PrecisionTensor& tail_state = *state;
+        puf_zero(&tail_state, stream);
+        PrecisionTensor decoder = policy_forward(
+            policy, *weights, *activations, observation, tail_state, stream);
+        copy_tail_decoder_values<<<
+            grid_size(bank_size), BLOCK_SIZE, 0, stream>>>(
+                decoder, pufferl->tail_values.data,
+                pufferl->tail_terminals.data, sub_start, bank_size);
+    }
+}
