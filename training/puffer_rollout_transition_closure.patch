+__global__ void copy_tail_decoder_values(
+        PrecisionTensor decoder, precision_t* tail_values,
+        const precision_t* tail_terminals, int output_start, int rows) {
+    int row = blockIdx.x * blockDim.x + threadIdx.x;
+    if (row >= rows) return;
+    int output_row = output_start + row;
+    int stride = decoder.shape[1];
+    precision_t value = decoder.data[(long)row * stride + stride - 1];
+    tail_values[output_row] = to_float(tail_terminals[output_row]) == 0.0f
+        ? value : from_float(0.0f);
