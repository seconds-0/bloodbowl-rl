+static void require_fresh_training_tail(PuffeRL& pufferl) {
+    std::vector<int> tail_valid(pufferl.hypers.num_buffers);
+    cudaError_t status = cudaMemcpy(
+        tail_valid.data(),
+        pufferl.tail_valid.data,
+        tail_valid.size() * sizeof(int),
+        cudaMemcpyDeviceToHost);
+    if (status != cudaSuccess) {
+        pufferl.training_failed = true;
+        throw std::runtime_error(
+            "training could not read tail-record validity");
+    }
+    for (int valid : tail_valid) {
+        if (valid != 1) {
+            throw std::runtime_error(
+                "training requires one valid tail record per rollout buffer");
+        }
+    }
+}
+
+static void consume_training_tail(PuffeRL& pufferl) {
+    cudaError_t status = cudaMemsetAsync(
+        pufferl.tail_valid.data,
+        0,
+        pufferl.hypers.num_buffers * sizeof(int),
+        pufferl.default_stream);
+    if (status == cudaSuccess) {
+        status = cudaStreamSynchronize(pufferl.default_stream);
+    }
+    if (status != cudaSuccess) {
+        pufferl.training_failed = true;
+        throw std::runtime_error(
+            "training could not clear consumed tail records");
+    }
+}
