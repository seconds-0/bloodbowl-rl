+static bool primary_tail_storage_create(PuffeRL* pufferl, int primary_slice,
+        int input_size, int hidden_size, int num_layers) {
+    int total_agents = pufferl->hypers.total_agents;
+    int num_buffers = pufferl->hypers.num_buffers;
+    Allocator* tail_acts = &pufferl->tail_acts_alloc;
+
