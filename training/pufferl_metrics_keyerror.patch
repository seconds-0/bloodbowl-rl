+def _downsample_logs(all_logs, n):
+    """Downsample numeric curves and retain the latest text metadata."""
+    metrics = {}
+    metadata = {}
+    value_kinds = {}
+    logged_timesteps = all_logs[-1]['agent_steps']
+    next_bin = logged_timesteps / (n - 1) if n > 1 else np.inf
+    for log in all_logs:
+        for k, v in log.items():
+            if isinstance(v, str):
+                kind = 'metadata'
+            elif isinstance(v, (
+                    bool, int, float, np.bool_, np.integer, np.floating)):
+                kind = 'metric'
+            else:
+                raise TypeError(
+                    f'log field {k!r} has unsupported value type '
+                    f'{type(v).__name__}')
+
+            previous_kind = value_kinds.setdefault(k, kind)
+            if previous_kind != kind:
+                raise TypeError(
+                    f'log field {k!r} changed from {previous_kind} to {kind}')
+            if kind == 'metadata':
+                metadata[k] = v
+            else:
+                metrics.setdefault(k, [[]])[-1].append(v)
+
+        if log['agent_steps'] < next_bin:
+            continue
+
+        next_bin += logged_timesteps / (n - 1)
+        for k in metrics:
+            metrics[k][-1] = (
+                np.mean(metrics[k][-1]) if metrics[k][-1] else float("nan"))
+            metrics[k].append([])
+
+    for k in metrics:
+        if k in all_logs[-1]:
+            metrics[k][-1] = all_logs[-1][k]
+        elif metrics[k][-1]:
+            metrics[k][-1] = np.mean(metrics[k][-1])
+        else:
+            metrics[k][-1] = float("nan")
+
+    return metrics, metadata
+
+
