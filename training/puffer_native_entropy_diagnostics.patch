+py::dict qualification_entropy_gradient_state(
+        py::object pufferl_obj,
+        size_t max_bytes = QUALIFICATION_MAX_SNAPSHOT_BYTES) {
+    PuffeRL& pufferl = pufferl_obj.cast<PuffeRL&>();
+    require_idle_entropy_transaction(pufferl);
+    if (max_bytes == 0 || max_bytes > QUALIFICATION_MAX_SNAPSHOT_BYTES) {
+        throw std::runtime_error(
+            "invalid entropy gradient evidence byte limit");
+    }
+    if (USE_BF16 || pufferl.is_continuous) {
+        throw std::runtime_error(
+            "entropy gradient evidence requires a discrete fp32 policy");
+    }
+    if (pufferl.training_failed ||
+            pufferl.defer_entropy_schedule_commit ||
+            pufferl.entropy_schedule_commit_pending) {
+        throw std::runtime_error(
+            "entropy gradient evidence requires a successful committed update");
+    }
+    if (pufferl.current_ent_epoch < 0 ||
+            pufferl.current_ent_epoch == std::numeric_limits<long>::max() ||
+            pufferl.epoch != pufferl.current_ent_epoch + 1 ||
+            pufferl.entropy_schedule_update_count != 1 ||
+            pufferl.entropy_loss_minibatch_count != 1 ||
+            !pufferl.entropy_schedule_valid) {
+        throw std::runtime_error(
+            "entropy gradient evidence requires one unread public update");
+    }
+    if (pufferl.hypers.total_agents <= 0 || pufferl.hypers.horizon <= 0 ||
+            pufferl.hypers.total_agents >
+                std::numeric_limits<int>::max() / pufferl.hypers.horizon) {
+        throw std::runtime_error(
+            "entropy gradient evidence has an invalid batch shape");
+    }
+    int full_batch =
+        pufferl.hypers.total_agents * pufferl.hypers.horizon;
+    if (pufferl.hypers.minibatch_size != full_batch) {
+        throw std::runtime_error(
+            "entropy gradient evidence requires a full-batch minibatch");
+    }
+    double minibatches_real =
+        static_cast<double>(pufferl.hypers.replay_ratio) *
+        static_cast<double>(full_batch) /
+        static_cast<double>(pufferl.hypers.minibatch_size);
+    if (!std::isfinite(minibatches_real) ||
+            std::floor(minibatches_real) != 1.0) {
+        throw std::runtime_error(
+            "entropy gradient evidence requires exactly one minibatch");
+    }
+    if (pufferl.train_activations.decoder == nullptr) {
+        throw std::runtime_error(
+            "entropy gradient decoder activation is unavailable");
+    }
+    DecoderActivations* decoder = reinterpret_cast<DecoderActivations*>(
+        pufferl.train_activations.decoder);
+    if (decoder->out.data == nullptr ||
+            pufferl.ppo_bufs_puf.grad_logits.data == nullptr ||
+            pufferl.ppo_bufs_puf.grad_values.data == nullptr ||
+            pufferl.train_buf.mb_actions.data == nullptr ||
+            pufferl.train_buf.mb_logprobs.data == nullptr ||
+            pufferl.train_buf.mb_advantages.data == nullptr ||
+            pufferl.train_buf.mb_prio.data == nullptr ||
+            pufferl.train_buf.mb_action_mask.data == nullptr ||
+            pufferl.act_sizes_puf.data == nullptr ||
+            pufferl.ppo_bufs_puf.ent_coef.data == nullptr) {
+        throw std::runtime_error(
+            "entropy gradient evidence tensors are incomplete");
+    }
+    if (cudaDeviceSynchronize() != cudaSuccess) {
+        throw std::runtime_error(
+            "entropy gradient evidence synchronization failed");
+    }
+    if (ndim(decoder->out.shape) != 2 ||
+            decoder->out.shape[0] != full_batch ||
+            decoder->out.shape[1] <= 1 ||
+            ndim(pufferl.ppo_bufs_puf.grad_values.shape) != 3 ||
+            pufferl.ppo_bufs_puf.grad_values.shape[0] !=
+                pufferl.hypers.total_agents ||
+            pufferl.ppo_bufs_puf.grad_values.shape[1] !=
+                pufferl.hypers.horizon ||
+            pufferl.ppo_bufs_puf.grad_values.shape[2] != 1) {
+        throw std::runtime_error(
+            "entropy gradient evidence has an invalid logical shape");
+    }
+    PrecisionTensor decoder_output = {
+        .data = decoder->out.data,
+        .shape = {pufferl.hypers.total_agents, pufferl.hypers.horizon,
+                  decoder->out.shape[1]},
+    };
+    FloatTensor grad_values = {
+        .data = pufferl.ppo_bufs_puf.grad_values.data,
+        .shape = {pufferl.hypers.total_agents, pufferl.hypers.horizon},
+    };
+    size_t used = 0;
+    py::dict tensors;
+    tensors["decoder_output"] = qualification_precision_tensor(
+        "decoder_output", decoder_output, &used, max_bytes);
+    tensors["grad_logits"] = qualification_float_tensor(
+        "grad_logits", pufferl.ppo_bufs_puf.grad_logits, &used, max_bytes);
+    tensors["grad_values"] = qualification_float_tensor(
+        "grad_values", grad_values, &used, max_bytes);
+    tensors["mb_actions"] = qualification_precision_tensor(
+        "mb_actions", pufferl.train_buf.mb_actions, &used, max_bytes);
+    tensors["mb_logprobs"] = qualification_precision_tensor(
+        "mb_logprobs", pufferl.train_buf.mb_logprobs, &used, max_bytes);
+    tensors["mb_advantages"] = qualification_precision_tensor(
+        "mb_advantages", pufferl.train_buf.mb_advantages, &used, max_bytes);
+    tensors["mb_prio"] = qualification_precision_tensor(
+        "mb_prio", pufferl.train_buf.mb_prio, &used, max_bytes);
+    tensors["mb_action_mask"] = qualification_precision_tensor(
+        "mb_action_mask", pufferl.train_buf.mb_action_mask, &used, max_bytes);
+    tensors["act_sizes"] = qualification_int_tensor(
+        "act_sizes", pufferl.act_sizes_puf, &used, max_bytes);
+    tensors["entropy_coefficient"] = qualification_float_tensor(
+        "entropy_coefficient", pufferl.ppo_bufs_puf.ent_coef,
+        &used, max_bytes);
+    py::dict result;
+    result["contract"] = "ppo-entropy-preclip-gradient-v1";
+    result["completed_update_index"] = pufferl.current_ent_epoch;
+    result["committed_epoch"] = pufferl.epoch;
+    result["is_continuous"] = pufferl.is_continuous;
+    result["precision"] = "f32";
+    result["max_bytes"] = max_bytes;
+    result["used_bytes"] = used;
+    result["tensors"] = tensors;
+    return result;
+}
