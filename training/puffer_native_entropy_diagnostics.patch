+py::dict qualification_float_tensor(
+        const char* name, FloatTensor& tensor,
+        size_t* used_bytes, size_t max_bytes) {
+    py::dict result;
+    result["name"] = name;
+    result["dtype"] = "f32";
+    result["shape"] = qualification_shape(tensor.shape);
+    result["present"] = tensor.data != nullptr;
+    if (tensor.data == nullptr) {
+        result["data"] = py::bytes();
+        result["bytes"] = 0;
+        return result;
+    }
+    int64_t elements = numel(tensor.shape);
+    if (elements <= 0 ||
+            static_cast<uint64_t>(elements) >
+                static_cast<uint64_t>(std::numeric_limits<size_t>::max() /
+                                      sizeof(float))) {
+        throw std::runtime_error(
+            "qualification float tensor shape is invalid");
+    }
+    size_t nbytes = static_cast<size_t>(elements) * sizeof(float);
+    if (nbytes > max_bytes || *used_bytes > max_bytes - nbytes) {
+        throw std::runtime_error(
+            "entropy gradient evidence exceeds qualification byte limit");
+    }
+    std::vector<char> host(nbytes);
+    if (cudaMemcpy(host.data(), tensor.data, nbytes,
+            cudaMemcpyDeviceToHost) != cudaSuccess) {
+        throw std::runtime_error(
+            "qualification float tensor copy failed");
+    }
+    *used_bytes += nbytes;
+    result["data"] = py::bytes(host.data(), nbytes);
+    result["bytes"] = nbytes;
+    return result;
+}
