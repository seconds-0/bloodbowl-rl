diff --git a/pufferlib/torch_pufferl.py b/pufferlib/torch_pufferl.py
index 2b9557e78c682a732d460e4fdaeed060989b7b71..b26e8c60987073231b6f4eac9b0cc8fbed7ca93a 100644
--- a/pufferlib/torch_pufferl.py
+++ b/pufferlib/torch_pufferl.py
@@ -669,3 +669,15 @@ class PuffeRL:
         lp = self.logprobs.T.contiguous()
-        rew = self.rewards.T.contiguous().clamp(-1, 1)
+        # LOCAL PATCH (bloodbowl-rl, D234): this bound was -1, 1, which
+        # truncated legitimate emissions. A conceding loser's terminal stack
+        # is -reward_td - reward_win = -1.0 exactly, and the exact-PBRS
+        # terminal payback -Phi(s_T-1) lands on that same emission, so |raw|
+        # crossed the bound. Truncating the shaped SUM voids Ng-Harada-Russell
+        # policy invariance: the proof substitutes R' = R + F, and clip(R + F)
+        # does not decompose as R + (gamma*Phi' - Phi) for any potential. The
+        # leak is one-sided -- only the loss-side payback is destroyed -- so
+        # the agent banks the increments earned advancing the ball and repays
+        # none. This clamp is now a NaN/pathology guard only; the tight
+        # instrument is the env's derived clip threshold
+        # (bbe_reward_clip_threshold), which stays far below this bound.
+        rew = self.rewards.T.contiguous().clamp(-8, 8)
         ter = self.terminals.T.contiguous()
