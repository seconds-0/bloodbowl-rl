@@ -450,2 +450,14 @@ def _train(env_name, args, sweep_obj=None, result_queue=None, verbose=False):
 
+    # Local patch (bloodbowl-rl): warm-start training from a checkpoint.
+    # 'latest' resolves like eval(); absent/empty = cold start (upstream).
+    _load = args.get('load_model_path')
+    if _load:
+        if _load == 'latest':
+            _cands = glob.glob(os.path.join(
+                args['checkpoint_dir'], args['env_name'], '**', '*.bin'),
+                recursive=True)
+            _load = max(_cands, key=os.path.getctime)
+        backend.load_weights(pufferl, _load)
+        print(f'Warm-started training from {_load}')
+
     args.pop('nccl_id', None)
